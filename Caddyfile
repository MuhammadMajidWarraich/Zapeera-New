# Zapeera single-host reverse proxy — the ONLY public entry point.
# Site addresses come from the environment (docker-compose `caddy` service):
#   FRONTEND_DOMAIN  e.g. zapeera.seikho.online
#   API_DOMAIN       e.g. api.zapeera.seikho.online
# Moving to Zapeera's own domain later = change those values + DNS. No rebuild.
# Let's Encrypt needs no account/email by default; to receive expiry notices,
# add a line `email you@example.com` inside the global block below.
{
	auto_https disable_redirects
}

# --- Web app (same-origin): SPA at /, /api/* proxied by the frontend's own
# nginx to the backend (buffering off = SSE streams). Caddy just terminates
# TLS and passes through.
{$FRONTEND_DOMAIN} {
	encode gzip

	# QA Wave 2: baseline security headers on every response.
	# Hero live demo (2026-10-24): framing is governed by CSP
	# frame-ancestors — the app may be framed ONLY by itself and the
	# marketing site (which embeds the live demo). X-Frame-Options is
	# dropped because it cannot express the marketing origin; every
	# other origin stays denied by frame-ancestors.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self' https://zapeera.seikho.online"
	}

	# Content-hashed build assets never change under the same URL —
	# cache them hard. The SPA entry must always revalidate so a new
	# deploy is picked up immediately.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"

	reverse_proxy frontend:80
	log {
		output stdout
		format console
	}
}

# --- API direct alias: health checks, future mobile/desktop clients, debugging.
# SSE note: Caddy's reverse_proxy streams by default (flush_interval -1 =
# immediate flush, correct for text/event-stream); no special block needed.
{$API_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy backend:4200
	log {
		output stdout
		format console
	}
}

# --- Plain-HTTP entry points: send everyone to HTTPS (auto_https redirects
# are disabled above, so without these blocks http:// visitors get nothing).
http://{$FRONTEND_DOMAIN} {
	redir https://{host}{uri} permanent
}

http://{$API_DOMAIN} {
	redir https://{host}{uri} permanent
}
