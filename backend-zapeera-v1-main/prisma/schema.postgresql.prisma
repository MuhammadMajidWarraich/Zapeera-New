  @@index([userId], name: "idx_notif_pref_user")
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Backoffice module-permission matrix tables.
// Originally created by the backoffice service via raw SQL and missing from
// this schema, which made the startup schema-heal (prisma db push) propose
// dropping them. Modeled faithfully (columns, defaults, PK and the exact
// unique-constraint names match the live database) so db push is a no-op.
// ---------------------------------------------------------------------------

model PlanModulePermission {
  id         String    @id @default(cuid())
  planId     String
  moduleName String
  enabled    Boolean   @default(false)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@unique([planId, moduleName], map: "plan_module_permissions_planId_moduleName_key")
  @@map("plan_module_permissions")
}

model PlanSubModulePermission {
  id           String    @id @default(cuid())
  planId       String
  moduleName   String
  subModuleKey String
  enabled      Boolean   @default(true)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now()) @updatedAt

  @@unique([planId, moduleName, subModuleKey], map: "plan_sub_module_permissions_planId_moduleName_subModuleKey_key")
  @@map("plan_sub_module_permissions")
}

model RoleModulePermission {
  id         String    @id @default(cuid())
  roleName   String
  moduleName String
  enabled    Boolean   @default(false)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@unique([roleName, moduleName], map: "role_module_permissions_roleName_moduleName_key")
  @@map("role_module_permissions")
}

model RoleSubModulePermission {
  id           String    @id @default(cuid())
  roleName     String
  moduleName   String
  subModuleKey String
  enabled      Boolean   @default(true)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now()) @updatedAt

  @@unique([roleName, moduleName, subModuleKey], map: "role_sub_module_permissions_roleName_moduleName_subModuleKe_key")
  @@map("role_sub_module_permissions")
}

model BusinessTypeSubModulePermission {
  id             String    @id @default(cuid())
  businessTypeId String
  moduleName     String
  subModuleKey   String
  enabled        Boolean   @default(true)
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @default(now()) @updatedAt

  @@unique([businessTypeId, moduleName, subModuleKey], map: "business_type_sub_module_perm_businessTypeId_moduleName_sub_key")
  @@map("business_type_sub_module_permissions")
}

// ─── Clinic pack (Wave C4) ───────────────────────────────────────────
// Clinics previously had NO patient/doctor/appointment modules at all
// (billing + supplies inventory only). This pack adds Patient-Lite,
// Doctors, the Appointments/OPD token queue, visit billing through
// the normal sale engine, and doctor-share settlement.

// Patient-Lite: the clinic's own register of the people it treats.
// Deliberately separate from Customer (the sales/khata register): a
// patient is a clinical record. A visit invoice therefore carries no
// customerId — khata/loyalty stay POS decisions, not clinic ones.
model Patient {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  phone     String?
  age       Int?
  gender    String?
  cnic      String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Business      @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([companyId], name: "idx_patient_company")
  @@index([branchId], name: "idx_patient_branch")
  @@index([phone], name: "idx_patient_phone")
  @@map("patients")
}

// A doctor who sees patients at the clinic. consultationFee is the
// standard fee billed per visit; sharePercent is the DOCTOR's share
// of that fee (the clinic keeps the rest). Both are only DEFAULTS:
// at visit completion the fee actually charged and the share it
// produced are snapshotted onto the Appointment, and settlement
// reports read the snapshots — editing a doctor never rewrites
// history. serviceProductId points at the auto-ensured non-stock
// Product ("Consultation — Dr <name>", isService) whose sale line
// carries the fee on the visit invoice; the fee never touches stock.
model Doctor {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  specialization   String?
  phone            String?
  consultationFee  Float    @default(0)
  sharePercent     Float    @default(0)
  serviceProductId String?
  isActive         Boolean  @default(true)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Business           @relation(fields: [companyId], references: [id])
  serviceProduct Product?           @relation("DoctorServiceProduct", fields: [serviceProductId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  settlements    DoctorSettlement[]

  @@index([companyId], name: "idx_doctor_company")
  @@index([serviceProductId], name: "idx_doctor_service_product")
  @@map("doctors")
}

// One OPD visit. tokenNumber is the patient's place in the doctor's
// queue for the day: a per (doctor, appointmentDate) sequence the
// server assigns at booking (1, 2, 3, …), unique per doctor+day.
// appointmentDate is stored normalized to UTC midnight of the clinic
// day. Status flow:
//   BOOKED → CHECKED_IN → IN_VISIT → COMPLETED
//   BOOKED | CHECKED_IN → CANCELLED | NO_SHOW
// Completion (POST /appointments/:id/complete-visit) creates the
// visit invoice (a normal Sale), links it via saleId, links the C1
// Prescription it wrote via prescriptionId, and snapshots
// feeCharged + doctorShareAmount so settlement reporting never
// re-derives money from the doctor's current fee/share.
model Appointment {
  id                String    @id @default(cuid())
  companyId         String
  branchId          String?
  patientId         String
  doctorId          String
  appointmentDate   DateTime
  tokenNumber       Int
  status            String    @default("BOOKED") // BOOKED | CHECKED_IN | IN_VISIT | COMPLETED | CANCELLED | NO_SHOW
  reason            String?
  notes             String?
  saleId            String?
  prescriptionId    String?
  feeCharged        Float?
  doctorShareAmount Float?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company      Business      @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@unique([doctorId, appointmentDate, tokenNumber], name: "appt_doctor_date_token")
  @@index([companyId], name: "idx_appointment_company")
  @@index([branchId], name: "idx_appointment_branch")
  @@index([patientId], name: "idx_appointment_patient")
  @@index([doctorId, appointmentDate], name: "idx_appointment_doctor_date")
  @@index([status], name: "idx_appointment_status")
  @@map("appointments")
}

// A payout of doctor-share money to a doctor. periodFrom/periodTo
// record the earning window the payout is meant to cover. The
// settlement report's "outstanding" for a window is: doctor share
// earned in the window (Appointment snapshots) minus settlements
// PAID in the window (by settlement createdAt) — deliberately
// simple, documented semantics; see doctor.controller.
model DoctorSettlement {
  id         String   @id @default(cuid())
  companyId  String
  doctorId   String
  periodFrom DateTime
  periodTo   DateTime
  amount     Float
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Business @relation(fields: [companyId], references: [id])
  doctor  Doctor   @relation(fields: [doctorId], references: [id])

  @@index([companyId], name: "idx_doctor_settlement_company")
  @@index([doctorId], name: "idx_doctor_settlement_doctor")
  @@index([createdAt], name: "idx_doctor_settlement_createdAt")
  @@map("doctor_settlements")
}

// ─── Hotel pack (Wave C5) ────────────────────────────────────────────
// Hotels previously had NO property management at all (stock/billing
// only). This PMS-lite pack adds room types + rooms, reservations,
// check-in/out, guest folios (room-night charges, POS charge-to-room,
// manual/service charges, payments and advances), housekeeping room
// states and a night-audit-lite daily summary.

// A room category ("Deluxe King", "Twin", …) and its nightly rate.
// The rate is a DEFAULT for future stays: check-in snapshots it onto
// the Folio (rateSnapshot) and every room-night charge posts at the
// snapshot, so editing a type's rate never reprices a stay already
// in-house.
model RoomType {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  ratePerNight Float    @default(0)
  capacity     Int?
  description  String?
  isActive     Boolean  @default(true)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Business @relation(fields: [companyId], references: [id])
  rooms   Room[]

  @@index([companyId], name: "idx_room_type_company")
  @@map("room_types")
}

// One physical room. `number` is the door number ("101") and is
// unique per business. status is the front-desk board state:
//   AVAILABLE → OCCUPIED (check-in) → DIRTY (check-out) → AVAILABLE
//   (housekeeping marks it cleaned); AVAILABLE/DIRTY ⇄ MAINTENANCE
//   by hand. OCCUPIED is set and cleared ONLY by check-in/check-out —
//   the room status endpoint refuses to touch an occupied room.
model Room {
  id         String   @id @default(cuid())
  companyId  String
  branchId   String?
  roomTypeId String
  number     String
  floor      String?
  status     String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | DIRTY | MAINTENANCE
  isActive   Boolean  @default(true)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company      Business      @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  reservations Reservation[]
  folios       Folio[]

  @@unique([companyId, number], name: "room_company_number")
  @@index([companyId], name: "idx_room_company")
  @@index([branchId], name: "idx_room_branch")
  @@index([roomTypeId], name: "idx_room_type")
  @@index([status], name: "idx_room_status")
  @@map("rooms")
}

// A booking of one room for a date range. checkInDate/checkOutDate
// are stored normalized to UTC midnight (the clinic pack's rule) so
// the overlap test and the day queries agree exactly. Status flow:
//   BOOKED → CHECKED_IN → COMPLETED
//   BOOKED → CANCELLED | NO_SHOW
// CHECKED_IN is reached only through the check-in endpoint, which
// opens the stay's Folio; COMPLETED only through folio check-out.
// folioId mirrors Folio.reservationId — check-in writes the link
// from both sides in one transaction.
model Reservation {
  id           String   @id @default(cuid())
  companyId    String
  branchId     String?
  guestName    String
  guestPhone   String?
  guestCnic    String?
  // Guest documents (uploaded at booking): the CNIC scan and up to
  // 5 person photos, stored as reservation-documents/<file> refs.
  // Files live on disk and are served ONLY through the
  // authenticated, business-scoped document route — never static.
  cnicDocumentUrl String?
  guestPhotoUrls  Json?
  roomId       String
  checkInDate  DateTime
  checkOutDate DateTime
  adults       Int?
  children     Int?
  source       String?
  status       String   @default("BOOKED") // BOOKED | CHECKED_IN | COMPLETED | CANCELLED | NO_SHOW
  folioId      String?  @unique
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Business @relation(fields: [companyId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  room    Room     @relation(fields: [roomId], references: [id])
  folio   Folio?   @relation("ReservationFolio", fields: [folioId], references: [id], onDelete: SetNull)
  stayFolios Folio[] @relation("FolioReservation")

  @@index([companyId], name: "idx_reservation_company")
  @@index([branchId], name: "idx_reservation_branch")
  @@index([roomId], name: "idx_reservation_room")
  @@index([status], name: "idx_reservation_status")
  @@index([checkInDate], name: "idx_reservation_checkin")
  @@map("reservations")
}

// The stay itself — the hotel's bill for one room occupation, opened
// by check-in and closed by check-out. rateSnapshot freezes the room
// type's nightly rate at check-in. The folio's money truth is
// computed from its rows, never stored:
//   balance = Σ FolioCharge.amount − Σ FolioPayment.amount
// saleId links the checkout invoice (a normal Sale whose service
// lines summarize the folio-native charges — room nights plus
// SERVICE/MANUAL charges; POS sales charged to the room are separate
// sales and are NOT re-billed). A remaining balance at check-out can
// be forgiven only as an explicit write-off (writeOffAmount +
// writeOffNote, OWNER/MANAGER) — the folio records exactly what was
// forgiven and why.
model Folio {
  id             String    @id @default(cuid())
  companyId      String
  branchId       String?
  reservationId  String?
  roomId         String
  guestName      String
  guestPhone     String?
  rateSnapshot   Float     @default(0)
  status         String    @default("OPEN") // OPEN | CLOSED
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  saleId         String?
  writeOffAmount Float?
  writeOffNote   String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Business       @relation(fields: [companyId], references: [id])
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  room         Room           @relation(fields: [roomId], references: [id])
  reservation  Reservation?   @relation("FolioReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  forReservation Reservation? @relation("ReservationFolio")
  checkoutSale Sale?          @relation("FolioCheckoutInvoice", fields: [saleId], references: [id], onDelete: SetNull)
  chargedSales Sale[]         @relation("SaleChargedToFolio")
  charges      FolioCharge[]
  payments     FolioPayment[]

  @@index([companyId], name: "idx_folio_company")
  @@index([branchId], name: "idx_folio_branch")
  @@index([roomId], name: "idx_folio_room")
  @@index([reservationId], name: "idx_folio_reservation")
  @@index([status], name: "idx_folio_status")
  @@map("folios")
}

// One line the guest owes: a posted room night (ROOM_NIGHT, at the
// folio's rateSnapshot), a POS sale charged to the room (SERVICE
// with saleId set — the total of Sale <saleId>, written by the sale
// engine in the sale's own transaction), or a desk-added charge
// (SERVICE / MANUAL). Charges are an immutable ledger: rows are
// never edited or deleted by the API (createdAt only, no updatedAt).
model FolioCharge {
  id          String   @id @default(cuid())
  folioId     String
  description String
  amount      Float
  kind        String   @default("MANUAL") // ROOM_NIGHT | SERVICE | MANUAL
  saleId      String?
  chargeDate  DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  folio Folio @relation(fields: [folioId], references: [id])
  sale  Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([folioId], name: "idx_folio_charge_folio")
  @@index([saleId], name: "idx_folio_charge_sale")
  @@index([chargeDate], name: "idx_folio_charge_date")
  @@map("folio_charges")
}

// Money the guest paid against the folio: a booking advance, an
// in-stay payment, or the settling payment at check-out. `method`
// reuses the sale tender set (SALE_PAYMENT_METHODS).
model FolioPayment {
  id        String   @id @default(cuid())
  folioId   String
  amount    Float
  method    String
  paidAt    DateTime @default(now())
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  folio Folio @relation(fields: [folioId], references: [id])

  @@index([folioId], name: "idx_folio_payment_folio")
  @@index([paidAt], name: "idx_folio_payment_date")
  @@map("folio_payments")
}

// ── Cloud sync push idempotency (Sync Hardening) ─────────────────────────
// One row per processed client sync operation, keyed by (companyId, opKey)
// where opKey is the client's idempotencyKey when sent, else its op id.
// A retried push batch (client timeout → resend of the SAME batch) finds
// the recorded result here and returns it as DUPLICATE instead of
// re-applying the write. Only deterministic outcomes are recorded
// (ACCEPTED / CONFLICT / REJECTED); transient FAILED ops stay unrecorded
// so a later retry can still succeed. Rows are pruned opportunistically
// by the push endpoint once they are older than 7 days, which bounds the
// table to roughly a week of sync traffic per business.
model SyncProcessedOperation {
  id         String   @id @default(cuid())
  companyId  String
  opKey      String
  opId       String?
  entityType String
  entityId   String?
  operation  String
  status     String
  message    String?
  createdAt  DateTime @default(now())

  @@unique([companyId, opKey], name: "uq_sync_processed_op_key")
  @@index([createdAt], name: "idx_sync_processed_op_created")
  @@map("sync_processed_operations")
}

// ─── White-label partners (Feature 3) ─────────────────────────────────
// A Partner is a reseller company that sells Zapeera under its own
// branding. Businesses created through the partner's join link
// (?partner=<slug> / /join/<slug>) carry partnerId — set once at
// business creation, immutable for tenants afterwards (Backoffice can
// reassign). The partner's single v1 admin is adminUserId (a regular
// ZapeeraUser) who signs in to the tenant app and opens /partner.
// logoUrl is a base64 data-URI (same storage pattern as profile photos
// and prescription images — downscaled client-side before upload).
// Partners sell the standard platform plans in v1; partner-level plan
// pricing and partner custom domains are phase 2.
model Partner {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  primaryColor      String?
  supportEmail      String?
  tagline           String?
  adminUserId       String?
  pendingAdminEmail String?
  status            String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  admin        ZapeeraUser?         @relation("partnerAdmin", fields: [adminUserId], references: [id])
  businesses   Business[]           @relation("businessPartner")
  applications PartnerApplication[] @relation("partnerApplicationCreatedPartner")

  @@index([adminUserId], name: "idx_partner_admin")
  @@index([status], name: "idx_partner_status")
  @@map("partners")
}

// ─── White-label partner applications ─────────────────────────────────
// A prospective reseller applies (public marketing form = source WEB, or
// in-app while signed in = source APP). Backoffice reviews the queue:
// APPROVE creates the Partner (see approvePartnerApplication — when no
// Zapeera user owns the application email yet, the partner is created
// with pendingAdminEmail set and the admin claim resolves on that user's
// signup / first /partners/me call). REJECTED applications may re-apply.
model PartnerApplication {
  id               String    @id @default(cuid())
  companyName      String
  contactName      String
  email            String
  phone            String
  website          String?
  message          String?
  source           String    @default("WEB") // WEB | APP
  applicantUserId  String?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdPartnerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  applicantUser  ZapeeraUser? @relation("partnerApplicationApplicant", fields: [applicantUserId], references: [id])
  createdPartner Partner?     @relation("partnerApplicationCreatedPartner", fields: [createdPartnerId], references: [id])

  @@index([email, status], name: "idx_partner_application_email_status")
  @@index([status], name: "idx_partner_application_status")
  @@map("partner_applications")
}
