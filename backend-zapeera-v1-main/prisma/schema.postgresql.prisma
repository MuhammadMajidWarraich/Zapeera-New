  status          String    @default("PRESENT")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  branch          Branch      @relation(fields: [branchId], references: [id])
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id])
  membership      Membership  @relation(fields: [membershipId], references: [id])

  @@index([staffProfileId], name: "idx_attendance_staff_profile")
  @@index([membershipId], name: "idx_attendance_membership")
  @@index([branchId], name: "idx_attendance_branch")
  @@index([checkIn], name: "idx_attendance_checkIn")
  @@index([status], name: "idx_attendance_status")
  @@map("attendance")
}

model Shift {
  id              String    @id @default(cuid())
  staffProfileId  String
  membershipId    String
  branchId        String
  shiftDate       DateTime
  startTime       DateTime
  endTime         DateTime?
  openingBalance  Float     @default(0)
  cashIn          Float     @default(0)
  cashOut         Float     @default(0)
  expectedBalance Float?
