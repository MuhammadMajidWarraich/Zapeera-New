// DETERMINISTIC Prisma schema for PostgreSQL (Web / cloud mode).
// Generated client: npm run setup:web  (uses scripts/generate-client.js)
// Keep identical to schema.sqlite.prisma EXCEPT the datasource provider.
// scripts/check-schema-sync.js fails the build if the two drift.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin", "darwin-arm64", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ZapeeraUser {
  id                       String    @id @default(cuid())
  username                 String    @unique
  email                    String    @unique
  password                 String
  name                     String
  profileImage             String?
  phone                    String?
  address                  String?
  city                     String?
  country                  String?
  dateOfBirth              DateTime?
  bio                      String?
  isActive                 Boolean   @default(true)
  businessAccessGranted    Boolean   @default(true)
  twoFactorEnabled         Boolean   @default(false)
  sessionToken             String?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  welcomeEmailSent         Boolean   @default(false)
  lastLoginAt              DateTime?
  uuid                     String?   @unique
  syncStatus               String    @default("PENDING")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdBy                String?

  deviceActivations DeviceActivation[]
  card_details      card_details[]
  receipts          Receipt[]
  refunds           Refund[]
  sales             Sale[]
  scheduledShifts   ScheduledShiftUser[]
  memberships       Membership[]
  invitationsSent   BusinessInvitation[] @relation("inviter")
  billingProfiles   BillingProfile[]     @relation("userBillingProfiles")
  notifications     Notification[]
  hasUsedTrial      Boolean              @default(false)
  trialUsedAt       DateTime?

  @@map("zapeera_users")
}

model StaffProfile {
  id                       String       @id @default(cuid())
  membershipId             String       @unique
  employeeId               String       @unique
  designation              String?
  department               String?
  employmentType           String       @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  salary                   Float?
  salaryType               String       @default("MONTHLY") // MONTHLY, WEEKLY, DAILY, HOURLY
  joiningDate              DateTime     @default(now())
  probationEndDate         DateTime?
  confirmationDate         DateTime?
  resignationDate          DateTime?
  terminationDate          DateTime?
  terminationReason        String?
  bankName                 String?
  bankAccountNumber        String?
  bankBranchName           String?
  cnicNumber               String?
  cnicExpiry               DateTime?
  passportNumber           String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  reportingManagerId       String?
  shiftPreference          String?
  weeklyOffDays            String?      // JSON array: ["MON","WED"]
  annualLeaveBalance       Int          @default(0)
  sickLeaveBalance         Int          @default(0)
  casualLeaveBalance       Int          @default(0)
  documents                String?      // JSON array of document URLs
  notes                    String?
  performanceRating        Float?
  lastReviewDate           DateTime?
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  attendance   Attendance[]
  commissions  Commission[]
  shifts       Shift[]

  @@index([membershipId], name: "idx_staff_profile_membership")
  @@index([department], name: "idx_staff_profile_department")
  @@index([designation], name: "idx_staff_profile_designation")
  @@index([isActive], name: "idx_staff_profile_active")
  @@map("staff_profiles")
}

model Business {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String?  @unique
  description  String?
  address      String?
  phone        String?
  email        String?
  website      String?
  businessType String?
  createdBy    String?
  isActive     Boolean  @default(true)
  policyVersion Int      @default(0) // Bumped on auth-relevant changes (membership/override/subscription/business-type)
  uuid         String?  @unique
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deviceActivations         DeviceActivation[]
  branches                  Branch[]
  products                  Product[]
  customers                 Customer[]
  sales                     Sale[]
  batches                   Batch[]
  purchases                 Purchase[]
  stockTransfers            StockTransfer[]
  promotions                Promotion[]
  taxClasses                TaxClass[]
  categories                Category[]
  expenses                  Expense[]
  expenseCategories         ExpenseCategory[]
  memberships               Membership[]             @relation("memberships")
  roles                     Role[]                   @relation("roles")
  businessModules           BusinessModule[]         @relation("businessModules")
  businessModuleOverridesV2 BusinessModuleOverride[] @relation("businessModuleOverridesV2")
  businessSubscription      BusinessSubscription?    @relation("businessSubscription")
  // MULTI-TENANT: Invitations
  invitations               BusinessInvitation[]     @relation("businessInvitations")
  billingProfiles           BillingProfile[]         @relation("businessBillingProfiles")
  paymentProofs             PaymentProof[]           @relation("businessPaymentProofs")
  fbrConfig                 FbrConfig?
  fbrInvoiceQueue           FbrInvoiceQueue[]
  prescriptions             Prescription[]
  patients                  Patient[]
  doctors                   Doctor[]
  appointments              Appointment[]
  doctorSettlements         DoctorSettlement[]

  @@index([createdBy], name: "idx_business_createdBy")
  @@index([businessType], name: "idx_business_type")
  @@index([isActive], name: "idx_business_active")
  @@map("businesses")
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  address    String
  phone      String
  email      String
  companyId  String
  managerId  String?
  createdBy  String?
  isActive   Boolean  @default(true)
  uuid       String?  @unique
  syncStatus String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deviceActivations  DeviceActivation[]
  attendance         Attendance[]
  commissions        Commission[]
  customers          Customer[]
  products           Product[]
  receipts           Receipt[]
  sales              Sale[]
  shifts             Shift[]
  scheduledShifts    ScheduledShift[]
  batches            Batch[]
  purchases          Purchase[]
  stockTransfersOut  StockTransfer[]    @relation("stockTransfersOut")
  stockTransfersIn   StockTransfer[]    @relation("stockTransfersIn")
  prescriptions      Prescription[]
  patients           Patient[]
  appointments       Appointment[]
  categories         Category[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  manufacturers      Manufacturer[]
  suppliers          Supplier[]
  shelves            Shelf[]
  company            Business           @relation(fields: [companyId], references: [id])
  membershipBranches MembershipBranch[] @relation("membershipBranches")

  @@unique([name, companyId], name: "branch_name_per_company")
  @@index([companyId], name: "idx_branch_company")
  @@index([isActive], name: "idx_branch_active")
  @@map("branches")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String    @default("GENERAL")
  color       String?   @default("#3B82F6")
  branchId    String?
  companyId   String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch?   @relation(fields: [branchId], references: [id])
  company     Business? @relation(fields: [companyId], references: [id])
  products    Product[]
  promotions  Promotion[]

  @@unique([name, branchId], name: "category_name_per_branch")
  @@index([companyId], name: "idx_category_company")
  @@index([branchId], name: "idx_category_branch")
  @@map("categories")
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  companyId   String
  branchId    String?
  isActive    Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Business  @relation(fields: [companyId], references: [id])
  branch      Branch?   @relation(fields: [branchId], references: [id])
  expenses    Expense[]

  @@unique([name, companyId, branchId], name: "expense_category_name_per_scope")
  @@index([companyId], name: "idx_expense_category_company")
  @@index([branchId], name: "idx_expense_category_branch")
  @@map("expense_categories")
}

model Expense {
  id            String         @id @default(cuid())
  title         String
  description   String?
  vendor        String?
  amount        Float
  expenseDate   DateTime
  paymentMethod String         @default("CASH")
  reference     String?
  status        String         @default("PENDING")
  companyId     String
  branchId      String?
  categoryId    String?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Business       @relation(fields: [companyId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])

  @@index([companyId], name: "idx_expense_company")
  @@index([branchId], name: "idx_expense_branch")
  @@index([categoryId], name: "idx_expense_category")
  @@index([expenseDate], name: "idx_expense_date")
  @@map("expenses")
}

model Manufacturer {
  id          String     @id @default(cuid())
  name        String
  description String?
  phone       String?
  website     String?
  country     String?
  branchId    String?
  companyId   String?
  createdBy   String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  branch      Branch?    @relation(fields: [branchId], references: [id])
  suppliers   Supplier[]

  @@unique([name, branchId], name: "manufacturer_name_per_branch")
  @@index([companyId], name: "idx_manufacturer_company")
  @@index([branchId], name: "idx_manufacturer_branch")
  @@map("manufacturers")
}

model Supplier {
  id             String        @id @default(cuid())
  name           String
  contactPerson  String
  phone          String
  email          String?
  address        String?
  manufacturerId String?
  branchId       String?
  companyId      String?
  createdBy      String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branch         Branch?       @relation(fields: [branchId], references: [id])
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  products       Product[]
  batches        Batch[]
  purchases      Purchase[]

  @@unique([name, branchId], name: "supplier_name_per_branch")
  @@index([companyId], name: "idx_supplier_company")
  @@index([branchId], name: "idx_supplier_branch")
  @@map("suppliers")
}

model Shelf {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String?
  branchId    String?
  companyId   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch?  @relation(fields: [branchId], references: [id])
  batches     Batch[]

  @@unique([name, branchId], name: "shelf_name_per_branch")
  @@index([companyId], name: "idx_shelf_company")
  @@index([branchId], name: "idx_shelf_branch")
  @@map("shelves")
}

model Product {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  formula              String? // New field for product composition
  sku                  String    @unique
  categoryId           String
  supplierId           String? // Optional - supplier is assigned to batches, not products
  branchId             String
  companyId            String
  createdBy            String?
  minStock             Int       @default(10)
  maxStock             Int?
  // Auto-reorder (Wave C3): opt-in reorder point. Only products with
  // reorderLevel set participate in reorder suggestions; the suggested
  // quantity is reorderQuantity when set, else 2 x reorderLevel minus
  // current stock. minStock stays the low-stock ALERT threshold.
  reorderLevel         Int?
  reorderQuantity      Int?
  unitsPerPack         Int       @default(1)
  // Unit engine (Wave C2): tablets per STRIP for pack-structured
  // pharmacy products (a pack of 100 may hold 10 strips of 10).
  // Null = the product is not sold by the strip. When both are set,
  // unitsPerPack must be a whole multiple of unitsPerStrip
  // (validated in the product controller, 400 otherwise). Stock is
  // always counted in base units (tablets); unitsPerPack /
  // unitsPerStrip only describe how those units are packaged.
  unitsPerStrip        Int?
  barcode              String?   @unique
  additionalBarcodes   String?   // JSON array of additional barcodes: ["CODE1","CODE2"]
  barcodeType          String?   @default("CODE128") // CODE128, EAN13, EAN8, UPC_A, UPC_E, CODE39, QR
  isGenerated          Boolean   @default(false) // true if barcode was auto-generated
  requiresPrescription Boolean   @default(false)
  // Tax class (Wave B5): the rate group this product sells under.
  // Null = the company's default handling (its isDefault tax class,
  // or the defaultTax setting when it has no classes).
  taxClassId           String?
  // FBR POS (Wave B7): Pakistan Customs Tariff code for this product,
  // sent as the item PCTCode on fiscal invoices. Stored WITHOUT the
  // dot (spec: "1601.0000" is shared as "16010000"), digits only,
  // max 8. Null = the fiscal payload uses the documented fallback
  // "00000000".
  pctCode              String?
  // Service item (Wave C4 — Clinic pack): a product that is SOLD but
  // never stocked (consultation fees, procedures, charges). Sale
  // lines for service products skip batch resolution and stock
  // deduction entirely and store batchId null; refunds of such lines
  // restock nothing. Auto-ensured per doctor by the clinic module
  // ("Consultation — Dr <name>"); may also be flagged manually.
  isService            Boolean   @default(false)
  isActive             Boolean   @default(true)
  uuid                 String?   @unique
  syncStatus           String    @default("PENDING")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  expiryDate           DateTime?

  branch         Branch          @relation(fields: [branchId], references: [id])
  company        Business        @relation(fields: [companyId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  refundItems    RefundItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  batches        Batch[]
  purchaseItems  PurchaseItem[]
  stockTransferItems StockTransferItem[]
  prescriptionItems PrescriptionItem[]
  serviceForDoctors Doctor[]       @relation("DoctorServiceProduct")
  promotions     Promotion[]
  taxClass       TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  @@index([companyId], name: "idx_product_company")
  @@index([branchId], name: "idx_product_branch")
  @@index([categoryId], name: "idx_product_category")
  @@index([supplierId], name: "idx_product_supplier")
  @@index([taxClassId], name: "idx_product_tax_class")
  @@index([isActive], name: "idx_product_active")
  @@map("products")
}

model Batch {
  id                  String         @id @default(cuid())
  batchNo             String
  productId           String
  branchId            String
  companyId           String
  supplierId          String?
  supplierName        String?
  barcode             String?
  totalBoxes          Int            @default(0)
  unitsPerBox         Int            @default(0)
  quantity            Int            @default(0) // Current available quantity
  purchasePrice       Float // Price per unit when purchased
  sellingPrice        Float // Price per unit when sold
  stockPurchasePrice  Float          @default(0)
  paidAmount          Float          @default(0)
  supplierOutstanding Float          @default(0)
  supplierInvoiceNo   String?
  purchasingMethod    String?
  expireDate          DateTime?
  productionDate      DateTime?
  shelfId             String?
  shelfName           String?
  isActive            Boolean        @default(true)
  isReported          Boolean        @default(false)
  reportReason        String? // Reason for reporting the batch
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdBy           String?
  product             Product        @relation(fields: [productId], references: [id])
  branch              Branch         @relation(fields: [branchId], references: [id])
  company             Business       @relation(fields: [companyId], references: [id])
  shelf               Shelf?         @relation(fields: [shelfId], references: [id])
  supplier            Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseItems       PurchaseItem[]
  transferItemsOut    StockTransferItem[] @relation("transferSourceBatch")
  transferItemsIn     StockTransferItem[] @relation("transferDestBatch")
  saleItems           SaleItem[]

  @@unique([batchNo, productId, branchId])
  @@index([companyId], name: "idx_batch_company")
  @@index([branchId], name: "idx_batch_branch")
  @@index([productId], name: "idx_batch_product")
  @@index([isActive], name: "idx_batch_active")
  @@index([expireDate], name: "idx_batch_expireDate")
  @@map("batches")
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String
  branchId      String
  companyId     String
  invoiceNo     String?
  purchaseDate  DateTime       @default(now())
  totalAmount   Float          @default(0)
  paidAmount    Float          @default(0)
  outstanding   Float          @default(0)
  status        String         @default("PENDING")
  notes         String?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  company       Business       @relation(fields: [companyId], references: [id])
  purchaseItems PurchaseItem[]

  @@index([companyId], name: "idx_purchase_company")
  @@index([branchId], name: "idx_purchase_branch")
  @@index([supplierId], name: "idx_purchase_supplier")
  @@index([status], name: "idx_purchase_status")
  @@index([purchaseDate], name: "idx_purchase_date")
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  batchId    String?
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  batch      Batch?   @relation(fields: [batchId], references: [id])

  @@map("purchase_items")
}

model StockTransfer {
  id             String              @id @default(cuid())
  transferNumber String
  companyId      String
  fromBranchId   String
  toBranchId     String
  status         String              @default("PENDING") // PENDING | COMPLETED | CANCELLED
  notes          String?
  createdBy      String?
  completedBy    String?
  completedAt    DateTime?
  cancelledBy    String?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  company        Business            @relation(fields: [companyId], references: [id])
  fromBranch     Branch              @relation("stockTransfersOut", fields: [fromBranchId], references: [id])
  toBranch       Branch              @relation("stockTransfersIn", fields: [toBranchId], references: [id])
  items          StockTransferItem[]

  @@index([companyId], name: "idx_stockTransfer_company")
  @@index([fromBranchId], name: "idx_stockTransfer_fromBranch")
  @@index([toBranchId], name: "idx_stockTransfer_toBranch")
  @@index([status], name: "idx_stockTransfer_status")
  @@map("stock_transfers")
}

model StockTransferItem {
  id            String        @id @default(cuid())
  transferId    String
  productId     String
  sourceBatchId String
  destBatchId   String?
  quantity      Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transfer      StockTransfer @relation(fields: [transferId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  sourceBatch   Batch         @relation("transferSourceBatch", fields: [sourceBatchId], references: [id])
  destBatch     Batch?        @relation("transferDestBatch", fields: [destBatchId], references: [id])

  @@index([transferId], name: "idx_stockTransferItem_transfer")
  @@index([productId], name: "idx_stockTransferItem_product")
  @@index([sourceBatchId], name: "idx_stockTransferItem_sourceBatch")
  @@map("stock_transfer_items")
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  type      String
  quantity  Int
  reason    String?
  reference String?
  createdAt DateTime @default(now())
  createdBy String?
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId], name: "idx_stockMovement_product")
  @@index([type], name: "idx_stockMovement_type")
  @@index([createdAt], name: "idx_stockMovement_createdAt")
  @@map("stock_movements")
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String    @unique
  email          String?
  address        String?
  branchId       String
  companyId      String
  createdBy      String?
  totalPurchases Float     @default(0)
  loyaltyPoints  Int       @default(0)
  isVIP          Boolean   @default(false)
  lastVisit      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  branch         Branch    @relation(fields: [branchId], references: [id])
  company        Business  @relation(fields: [companyId], references: [id])
  sales          Sale[]
  ledgerEntries  CustomerLedgerEntry[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([companyId], name: "idx_customer_company")
  @@index([branchId], name: "idx_customer_branch")
  @@index([isActive], name: "idx_customer_active")
  @@map("customers")
}

// Udhaar / khata ledger (Wave B2): one append-only row per movement of a
// customer's running credit balance. `amount` is signed — a positive
// amount increases what the customer owes, a negative amount reduces it:
//   SALE_DUE   + (total − paid) of a sale made on credit, written by the
//              sale-create transaction; discount edits and sale deletion
//              write compensating SALE_DUE rows for the delta.
//   PAYMENT    − a khata payment collected from the customer.
//   REFUND     − the part of a refund that cancels outstanding due
//              instead of being handed back in cash.
//   ADJUSTMENT ± manual correction (OWNER/MANAGER only, note required).
// The customer's balance is the SUM of their rows — never stored — so
// the statement and the balance can never disagree. `saleId` is SetNull
// on sale deletion so the statement survives the sale row going away
// (the note keeps the invoice number readable).
model CustomerLedgerEntry {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  type       String // SALE_DUE | PAYMENT | ADJUSTMENT | REFUND
  amount     Float // signed: + increases the customer's due, − reduces it
  method     String? // tender for PAYMENT rows: CASH | CARD | JAZZCASH | EASYPAISA | BANK_TRANSFER | MOBILE
  reference  String? // txn id / receipt reference for the payment, when any
  note       String?
  saleId     String? // originating sale for SALE_DUE / REFUND rows
  createdBy  String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([customerId], name: "idx_customer_ledger_customer")
  @@index([companyId], name: "idx_customer_ledger_company")
  @@index([saleId], name: "idx_customer_ledger_sale")
  @@index([createdAt], name: "idx_customer_ledger_createdAt")
  @@map("customer_ledger_entries")
}

// Loyalty points ledger (Wave B3): one append-only row per movement of
// a customer's points. `points` is the SIGNED delta that was applied to
// Customer.loyaltyPoints in the same transaction:
//   EARN     + points earned on a sale (1 per full PKR 100 of the
//            sale's final total — the long-standing earn rule).
//   REDEEM   − points spent at the POS in exchange for a bill discount
//            (points × the `loyaltyPointValue` setting, in PKR).
//   REVERSAL ± a refund or sale deletion unwinding part/all of a sale's
//            EARN (−) or REDEEM (+); refund reversals also carry the
//            refundId. Per-sale REVERSAL rows are summed by sign on
//            sale deletion so nothing is ever reversed twice.
//   ADJUST   ± manual correction (OWNER/MANAGER only, note required).
// Customer.loyaltyPoints stays the cached balance; every code path that
// changes it writes the matching row in the same transaction, so the
// ledger and the balance can never diverge. `saleId`/`refundId` are
// SetNull on delete so the history survives the source row going away.
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  type       String // EARN | REDEEM | REVERSAL | ADJUST
  points     Int // signed delta applied to Customer.loyaltyPoints
  saleId     String? // originating sale for EARN / REDEEM / REVERSAL rows
  refundId   String? // originating refund for REVERSAL rows
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  refund     Refund?  @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([customerId], name: "idx_loyalty_txn_customer")
  @@index([companyId], name: "idx_loyalty_txn_company")
  @@index([saleId], name: "idx_loyalty_txn_sale")
  @@index([createdAt], name: "idx_loyalty_txn_createdAt")
  @@map("loyalty_transactions")
}

model Sale {
  id                 String    @id @default(cuid())
  invoiceNumber      String?   @unique
  customerId         String?
  userId             String
  branchId           String
  companyId          String
  createdBy          String?
  subtotal           Float
  taxAmount          Float
  discountAmount     Float     @default(0)
  discountPercentage Float?    @default(0)
  // Loyalty redemption (Wave B3): points spent on this sale and the PKR
  // discount they bought. The discount is a component of totalAmount
  // (applied after the sale discount, before tax), NOT part of
  // discountAmount. loyaltyPointsEarned records the points this sale
  // credited, so refunds/deletion can reverse exactly. All three are
  // null on pre-B3 sales and on walk-in sales.
  loyaltyPointsRedeemed Int?
  loyaltyDiscount       Float?
  loyaltyPointsEarned   Int?
  // Promotions (Wave B4): total discount granted by the promotions
  // engine on this sale (BUY_X_GET_Y line offers + the single
  // order-level promotion). Like loyaltyDiscount it is a component of
  // totalAmount — applied after the manual sale discount and before
  // loyalty — NOT part of discountAmount. The per-promotion breakdown
  // lives in SalePromotion rows. Null on pre-B4 sales / no promo.
  promotionDiscount     Float?
  // FBR POS (Wave B7): the fiscal invoice number FBR returned for
  // this sale and the fiscalization status mirrored from the latest
  // FbrInvoiceQueue row (PENDING | SENT | FAILED | TEST | SKIPPED).
  // Both null when FBR was not enabled for the business at sale time.
  // Credit notes for refunds live in their own queue rows and do not
  // overwrite these sale-level fields.
  fbrInvoiceNumber      String?
  fbrStatus             String?
  // Prescriptions (Wave C1): the register record this sale
  // dispensed against, when one was attached at the POS. Null for
  // ordinary sales and for pre-C1 history.
  prescriptionId        String?
  totalAmount        Float
  paidAmount         Float     @default(0)
  returnedAmount     Float     @default(0)
  paymentMethod      String
  paymentStatus      String    @default("PENDING")
  status             String    @default("COMPLETED")
  saleDate           DateTime?
  membershipId       String?
  uuid               String?   @unique
  syncStatus         String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  receipts Receipt[]
  refunds  Refund[]    @relation("SaleRefunds")
  items    SaleItem[]
  payments SalePayment[]
  promotions SalePromotion[]
  taxLines SaleTaxLine[]
  fbrInvoices FbrInvoiceQueue[]
  ledgerEntries CustomerLedgerEntry[]
  loyaltyTransactions LoyaltyTransaction[]
  branch   Branch      @relation(fields: [branchId], references: [id])
  company  Business    @relation(fields: [companyId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  user     ZapeeraUser @relation(fields: [userId], references: [id])

  @@index([companyId], name: "idx_sale_company")
  @@index([branchId], name: "idx_sale_branch")
  @@index([customerId], name: "idx_sale_customer")
  @@index([userId], name: "idx_sale_user")
  @@index([saleDate], name: "idx_sale_date")
  @@index([status], name: "idx_sale_status")
  @@index([prescriptionId], name: "idx_sale_prescription")
  @@index([paymentStatus], name: "idx_sale_paymentStatus")
  @@index([createdAt], name: "idx_sale_createdAt")
  @@map("sales")
}

model SaleItem {
  id            String    @id @default(cuid())
  saleId        String
  productId     String
  batchId       String? // Link to specific batch
  createdBy     String?
  quantity      Int
  unitsDeducted Int? // Actual units deducted (box => qty * unitsPerBox)
  unitsPerBox   Int? // Units per box for this sale item
  saleType      String? // UNIT | BOX
  // Unit engine (Wave C2): the selling level the line was entered at
  // (PACK | STRIP | UNIT) and the base-units-per-level snapshot taken
  // from the product at sale time. Null on pre-C2 lines and on lines
  // whose client sent no unitLevel (voice/desktop/legacy BOX flows) —
  // those keep their historical representation exactly. On C2 lines
  // `quantity` and `unitsDeducted` BOTH hold BASE units (tablets):
  // the entered level quantity is quantity / unitFactor, and the
  // stored unitPrice is the price per LEVEL unit, so the stored
  // totalPrice (level qty x unitPrice) stays the money truth while
  // every quantity-keyed consumer (stock, COGS, refunds, reports)
  // reads base units.
  unitLevel     String? // PACK | STRIP | UNIT (Wave C2)
  unitFactor    Int? // Base units per unitLevel unit, snapshot (Wave C2)
  unitPrice     Float
  totalPrice    Float
  batchNumber   String? // Keep for backward compatibility
  expiryDate    DateTime?
  product       Product   @relation(fields: [productId], references: [id])
  batch         Batch?    @relation(fields: [batchId], references: [id])
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

// Split tender (Wave B1): one row per tender allocation of a sale.
// `Sale.paymentMethod` stays as the headline tender for backward
// compatibility — the single method for one-tender sales, or 'MIXED'
// when a sale is split across methods. `amount` is Float like every
// other money field in this schema (subtotal/totalAmount/paidAmount).
model SalePayment {
  id        String   @id @default(cuid())
  saleId    String
  method    String // CASH | CARD | JAZZCASH | EASYPAYSA | BANK_TRANSFER | MOBILE
  amount    Float
  reference String? // txn id / account title etc., when the tender has one
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId], name: "idx_sale_payment_sale")
  @@index([method], name: "idx_sale_payment_method")
  @@map("sale_payments")
}

// Promotions & coupons (Wave B4): shop-defined offers the sale engine
// evaluates SERVER-SIDE at checkout — clients never send a discount,
// only a coupon code. Kinds:
//   PERCENT / FLAT — order-level: `value` is the percentage (0–100) or
//     the flat PKR amount, taken off the scoped, post-manual-discount
//     base. At most ONE order-level promotion applies per sale: the
//     coupon whose code was sent, or the single best automatic one.
//   BUY_X_GET_Y — line-level: in every group of (buyQty + getQty)
//     units of the scoped items, getQty units are free. Applied as a
//     discount amount valued at the lines' prices; quantities and
//     stock are untouched (free units still leave the shelf).
// `code` is the coupon code (stored upper-case, unique per company);
// null = automatic promotion that needs no code. `usedCount` counts
// redemptions and is incremented inside the sale transaction (and
// decremented again if that sale is deleted).
model Promotion {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  type       String // PERCENT | FLAT | BUY_X_GET_Y
  value      Float // PERCENT: 0–100 · FLAT: PKR amount · BUY_X_GET_Y: unused (0)
  buyQty     Int? // BUY_X_GET_Y: paid units per group
  getQty     Int? // BUY_X_GET_Y: free units per group
  scope      String   @default("ALL") // ALL | CATEGORY | PRODUCT
  categoryId String?
  productId  String?
  code       String? // coupon code (upper-case); null = automatic
  minBill    Float? // minimum post-item-discount subtotal, when set
  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?
  usedCount  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Business  @relation(fields: [companyId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])
  product    Product?  @relation(fields: [productId], references: [id])
  salePromotions SalePromotion[]

  @@unique([companyId, code], name: "promotion_code_per_company")
  @@index([companyId], name: "idx_promotion_company")
  @@index([code], name: "idx_promotion_code")
  @@map("promotions")
}

// One row per promotion redeemed on a sale (Wave B4): the audit trail
// behind Sale.promotionDiscount, which stores their SUM. `code` is a
// snapshot of the promotion's code at redemption (null for automatic
// promotions) so the receipt/history stays readable even if the
// promotion is later renamed or recoded.
model SalePromotion {
  id             String   @id @default(cuid())
  saleId         String
  promotionId    String
  discountAmount Float
  code           String?
  createdAt      DateTime @default(now())
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion      Promotion @relation(fields: [promotionId], references: [id])

  @@index([saleId], name: "idx_sale_promotion_sale")
  @@index([promotionId], name: "idx_sale_promotion_promotion")
  @@map("sale_promotions")
}

// A tax rate group a business sells under (Wave B5): products point at
// a class; products without one fall back to the company's default —
// its isDefault class when it has classes, otherwise the long-standing
// defaultTax setting. Class names/rates are SNAPSHOTTED onto each
// sale's SaleTaxLine rows at creation, so editing or retiring a class
// never rewrites the tax history of past sales. DELETE is soft
// (isActive = false), like promotions.
model TaxClass {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rate      Float // percent: 17 means 17%
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Business @relation(fields: [companyId], references: [id])
  products  Product[]
  saleTaxLines SaleTaxLine[]

  @@unique([companyId, name], name: "tax_class_name_per_company")
  @@index([companyId], name: "idx_tax_class_company")
  @@map("tax_classes")
}

// One row per tax-class group on a sale (Wave B5): the audit/breakdown
// behind Sale.taxAmount, which stores the SUM of these rows' taxAmount.
// className/rate are snapshots taken at sale creation. taxClassId is
// null for the implicit default group (the company has no applicable
// class, so the defaultTax setting rate was used) and is SetNull if
// the class row is ever hard-removed — the snapshots keep the row
// meaningful either way.
model SaleTaxLine {
  id            String    @id @default(cuid())
  saleId        String
  taxClassId    String?
  className     String
  rate          Float // percent snapshot
  taxableAmount Float
  taxAmount     Float
  createdAt     DateTime  @default(now())
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  taxClass      TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  @@index([saleId], name: "idx_sale_tax_line_sale")
  @@index([taxClassId], name: "idx_sale_tax_line_class")
  @@map("sale_tax_lines")
}

// Prescriptions register (Wave C1 — Pharmacy pack): the record of a
// paper prescription a pharmacy received, and the medicines written on
// it. This module existed in the module hierarchy + route protection
// since early on but had no model/API/UI — only the
// Product.requiresPrescription flag. The register is a LEGAL record:
// rows are never hard-deleted by the API. A prescription is VOIDED
// (isActive = false + voidReason/voidedAt/voidedBy) so the audit
// trail — and the sales that dispensed against it — stays readable.
// A voided prescription can no longer be attached to a new sale.
// `imageUrl` holds the scanned/photo copy of the paper prescription:
// a data URI stored inline (the way profile pictures are kept in
// this codebase) or an uploads path; optional either way.
model Prescription {
  id           String    @id @default(cuid())
  companyId    String
  branchId     String?
  patientName  String
  patientPhone String?
  doctorName   String?
  doctorReg    String?
  notes        String?
  imageUrl     String?
  issuedDate   DateTime
  isActive     Boolean   @default(true)
  voidReason   String?
  voidedAt     DateTime?
  voidedBy     String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Business         @relation(fields: [companyId], references: [id])
  branch  Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items   PrescriptionItem[]
  sales   Sale[]
  appointments Appointment[]

  @@index([companyId], name: "idx_prescription_company")
  @@index([branchId], name: "idx_prescription_branch")
  @@index([patientPhone], name: "idx_prescription_patient_phone")
  @@index([createdAt], name: "idx_prescription_createdAt")
  @@map("prescriptions")
}

// One medicine line of a prescription. productName is a SNAPSHOT from
// creation time: the register must read correctly even after the
// product is renamed or retired. quantity is Float (a paper
// prescription may prescribe fractional pack quantities) and dosage
// is free text in the local convention, e.g. "1+0+1" (morning +
// noon + night).
model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  productId      String
  productName    String
  quantity       Float
  dosage         String?
  durationDays   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([prescriptionId], name: "idx_prescription_item_prescription")
  @@index([productId], name: "idx_prescription_item_product")
  @@map("prescription_items")
}

// FBR POS fiscal integration (Wave B7): one config row per business.
// Holds the credentials the business registered with FBR's POS
// invoicing (IMS) program. `apiToken` is the Bearer token FBR/PRAL
// issued for the POS ID — it is stored like the codebase's other
// secrets (a plain column, e.g. user password hashes live the same
// way) and is NEVER returned by the API (reads expose only
// `hasToken`) and NEVER logged. `environment`:
//   TEST       — no network call at all; the worker simulates a
//                format-faithful FBR invoice number locally so the
//                whole UX (queue, receipt QR, retry) is verifiable
//                without FBR credentials. Default for new configs.
//   SANDBOX    — PRAL IMS sandbox endpoint.
//   PRODUCTION — PRAL IMS production endpoint.
model FbrConfig {
  id          String   @id @default(cuid())
  companyId   String   @unique
  enabled     Boolean  @default(false)
  posId       String?
  apiToken    String?
  environment String   @default("TEST") // TEST | SANDBOX | PRODUCTION
  // Receipt/registration identity: overrides for the FBR-registered
  // trade name and STRN when they differ from the Business row (the
  // payload itself carries no seller block in the IMS model, but the
  // printed receipt header uses these when set).
  sellerName  String?
  sellerStrn  String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Business @relation(fields: [companyId], references: [id])

  @@map("fbr_configs")
}

// FBR POS fiscal integration (Wave B7): the durable outbox for fiscal
// postings. One row per fiscal document: the sale itself
// (kind = SALE, InvoiceType 1) and one per fiscalized refund
// (kind = CREDIT_NOTE, InvoiceType 3 with RefUSIN = the original
// sale's USIN — the IMS spec's credit-note flow). Rows are created
// AFTER the sale/refund transaction commits; the sale is never
// blocked on FBR. The worker posts due rows with backoff (1m, 5m,
// 15m) and gives up after 3 attempts → FAILED, from where an
// owner/manager can retry manually. `idempotencyKey` is unique so a
// sale (or refund) can never be fiscalized twice:
// "SALE:<saleId>" / "CN:<refundId>".
model FbrInvoiceQueue {
  id               String    @id @default(cuid())
  companyId        String
  saleId           String
  refundId         String?
  kind             String    @default("SALE") // SALE | CREDIT_NOTE
  idempotencyKey   String    @unique
  status           String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED | TEST
  attempts         Int       @default(0)
  nextAttemptAt    DateTime?
  lastError        String?
  fbrInvoiceNumber String?
  isTest           Boolean   @default(false)
  requestPayload   Json?
  responsePayload  Json?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Business  @relation(fields: [companyId], references: [id])
  sale             Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refund           Refund?   @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([companyId], name: "idx_fbr_queue_company")
  @@index([saleId], name: "idx_fbr_queue_sale")
  @@index([status, nextAttemptAt], name: "idx_fbr_queue_due")
  @@map("fbr_invoice_queue")
}

model Receipt {
  id            String      @id @default(cuid())
  saleId        String
  userId        String
  branchId      String
  createdBy     String?
  receiptNumber String      @unique
  printedAt     DateTime    @default(now())
  branch        Branch      @relation(fields: [branchId], references: [id])
  sale          Sale        @relation(fields: [saleId], references: [id])
  user          ZapeeraUser @relation(fields: [userId], references: [id])

  @@map("receipts")
}

model Refund {
  id             String       @id @default(cuid())
  originalSaleId String
  refundReason   String
  refundAmount   Float
  refundMethod   String? // Tender the refund was returned through (Wave B1)
  refundReference String? // txn id / account title for that tender, when any
  refundedBy     String
  createdBy      String?
  status         String       @default("PENDING")
  processedAt    DateTime?
  createdAt      DateTime?    @default(now())
  updatedAt      DateTime?    @default(now()) @updatedAt
  items          RefundItem[]
  loyaltyTransactions LoyaltyTransaction[]
  originalSale   Sale         @relation("SaleRefunds", fields: [originalSaleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refundedByUser ZapeeraUser  @relation(fields: [refundedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fbrCreditNotes FbrInvoiceQueue[]

  @@index([originalSaleId], name: "idx_refund_sale")
  @@index([status], name: "idx_refund_status")
  @@index([createdAt], name: "idx_refund_createdAt")
  @@map("refunds")
}

model RefundItem {
  id        String  @id @default(cuid())
  refundId  String
  productId String
  createdBy String?
  quantity  Int
  unitPrice Float
  reason    String
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund    Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refund_items")
}

model Attendance {
  id              String    @id @default(cuid())
  staffProfileId  String
  membershipId    String
  branchId        String
  checkIn         DateTime
  checkOut        DateTime?
  totalHours      Float?
  status          String    @default("PRESENT")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  branch          Branch      @relation(fields: [branchId], references: [id])
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id])
  membership      Membership  @relation(fields: [membershipId], references: [id])

  @@index([staffProfileId], name: "idx_attendance_staff_profile")
  @@index([membershipId], name: "idx_attendance_membership")
  @@index([branchId], name: "idx_attendance_branch")
  @@index([checkIn], name: "idx_attendance_checkIn")
  @@index([status], name: "idx_attendance_status")
  @@map("attendance")
}

model Shift {
  id              String    @id @default(cuid())
  staffProfileId  String
  membershipId    String
  branchId        String
  shiftDate       DateTime
  startTime       DateTime
  endTime         DateTime?
  openingBalance  Float     @default(0)
  cashIn          Float     @default(0)
  cashOut         Float     @default(0)
  expectedBalance Float?
  actualBalance   Float?
  difference      Float?
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  branch          Branch      @relation(fields: [branchId], references: [id])
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id])
  membership      Membership  @relation(fields: [membershipId], references: [id])

  @@index([staffProfileId], name: "idx_shift_staff_profile")
  @@index([membershipId], name: "idx_shift_membership")
  @@index([branchId], name: "idx_shift_branch")
  @@index([shiftDate], name: "idx_shift_date")
  @@index([status], name: "idx_shift_status")
  @@map("shifts")
}

model Commission {
  id                String    @id @default(cuid())
  staffProfileId    String
  membershipId      String
  branchId          String
  period            String
  periodType        String    @default("MONTHLY")
  totalSales        Float     @default(0)
  totalTransactions Int       @default(0)
  averageSale       Float     @default(0)
  baseRate          Float     @default(0.02)
  bonusRate         Float     @default(0)
  totalCommission   Float     @default(0)
  bonusAmount       Float     @default(0)
  totalAmount       Float     @default(0)
  status            String    @default("PENDING")
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  branch            Branch      @relation(fields: [branchId], references: [id])
  staffProfile      StaffProfile @relation(fields: [staffProfileId], references: [id])
  membership        Membership  @relation(fields: [membershipId], references: [id])

  @@index([staffProfileId], name: "idx_commission_staff_profile")
  @@index([membershipId], name: "idx_commission_membership")
  @@index([branchId], name: "idx_commission_branch")
  @@index([period], name: "idx_commission_period")
  @@index([status], name: "idx_commission_status")
  @@map("commissions")
}

model card_details {
  id              String           @id
  userId          String
  last4           String
  brand           String
  expiryMonth     Int
  expiryYear      Int
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  users           ZapeeraUser      @relation(fields: [userId], references: [id])
  billingProfiles BillingProfile[] @relation("billingProfilePaymentMethod")
}

model Settings {
  id          String   @id @default(cuid())
  createdBy   String
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([createdBy, key], name: "createdBy_key")
  @@index([createdBy], name: "idx_settings_createdBy")
  @@map("settings")
}

model ScheduledShift {
  id            String               @id @default(cuid())
  name          String
  startTime     String // Time in HH:MM format
  endTime       String // Time in HH:MM format
  date          DateTime // Date of the shift
  branchId      String
  maxUsers      Int                  @default(1)
  status        String               @default("SCHEDULED")
  notes         String?
  assignedUsers ScheduledShiftUser[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  branch        Branch               @relation(fields: [branchId], references: [id])

  @@map("scheduled_shifts")
}

model ScheduledShiftUser {
  id               String         @id @default(cuid())
  scheduledShiftId String
  userId           String
  assignedAt       DateTime       @default(now())
  assignedBy       String?
  scheduledShift   ScheduledShift @relation(fields: [scheduledShiftId], references: [id], onDelete: Cascade)
  user             ZapeeraUser    @relation(fields: [userId], references: [id])

  @@unique([scheduledShiftId, userId], name: "unique_shift_user")
  @@map("scheduled_shift_users")
}

// Enums removed - SQLite doesn't support enums, using String instead
// All enum values are now stored as strings in the database

model DeviceActivation {
  id                     String    @id @default(cuid())
  deviceId               String    @unique
  fingerprint            String
  status                 String    @default("PENDING") // PENDING, ACTIVE, INACTIVE
  licenseKey             String?
  userId                 String?
  companyId              String?
  branchId               String?
  platform               String?
  hostname               String?
  macAddress             String?
  notes                  String?
  offlineAccessExpiresAt DateTime?
  activatedBy            String?
  activatedAt            DateTime?
  lastVerifiedAt         DateTime?
  lastVerifiedStatus     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user    ZapeeraUser? @relation(fields: [userId], references: [id])
  company Business?    @relation(fields: [companyId], references: [id])
  branch  Branch?      @relation(fields: [branchId], references: [id])

  @@map("device_activations")
}

// =====================================
// MULTI-TENANT: ACCESS LAYER
// =====================================
model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  roleId     String?
  status     String   @default("ACTIVE") // ACTIVE, INVITED, INACTIVE
  invitedBy  String?
  uuid       String?  @unique
  syncStatus String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            ZapeeraUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  business        Business           @relation("memberships", fields: [businessId], references: [id], onDelete: Cascade)
  role            Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branches        MembershipBranch[]
  staffProfile    StaffProfile?
  attendance      Attendance[]
  shifts          Shift[]
  commissions     Commission[]

  @@unique([userId, businessId], name: "unique_user_business")
  @@index([userId], name: "idx_membership_user")
  @@index([businessId], name: "idx_membership_business")
  @@map("memberships")
}

model MembershipBranch {
  id           String   @id @default(cuid())
  membershipId String
  branchId     String
  uuid         String?  @unique
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation("membershipBranches", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId], name: "unique_membership_branch")
  @@index([membershipId], name: "idx_membership_branch_membership")
  @@index([branchId], name: "idx_membership_branch_branch")
  @@map("membership_branches")
}

// =====================================
// MULTI-TENANT: BUSINESS INVITATIONS
// =====================================
model BusinessInvitation {
  id         String    @id @default(cuid())
  businessId String
  email      String // Email of invited person (may not have account yet)
  invitedBy  String // User ID of inviter
  roleId     String?
  status     String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  expiresAt  DateTime? // When invitation expires
  token      String    @unique // Unique token for acceptance link
  acceptedAt DateTime? // When invitation was accepted
  rejectedAt DateTime? // When invitation was rejected
  uuid       String?   @unique
  syncStatus String    @default("PENDING")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business    @relation("businessInvitations", fields: [businessId], references: [id], onDelete: Cascade)
  inviter  ZapeeraUser @relation("inviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  role     Role?       @relation("invitationRoles", fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([businessId, email], name: "unique_invitation_per_business_email")
  @@index([businessId], name: "idx_invitation_business")
  @@index([email], name: "idx_invitation_email")
  @@index([token], name: "idx_invitation_token")
  @@index([status], name: "idx_invitation_status")
  @@map("business_invitations")
}

// =====================================
// MULTI-TENANT: RBAC SYSTEM
// =====================================
model Role {
  id         String   @id @default(cuid())
  businessId String? // NULL for global/platform roles, set for business-specific
  name       String
  description String?
  isSystem    Boolean  @default(false) // OWNER/MANAGER/CASHIER presets are protected
  isActive    Boolean  @default(true)
  // permissionState: UNCONFIGURED (no policy published yet — default deny) or
  // CONFIGURED (a policy was published; zero grants = deny all non-core).
  permissionState String @default("UNCONFIGURED")
  policyVersion   Int    @default(0)
  uuid         String?  @unique
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business? @relation("roles", fields: [businessId], references: [id], onDelete: Cascade)

  permissionsV2 RolePermissionV2[]   @relation("rolePermissionsV2")
  memberships   Membership[]
  invitations   BusinessInvitation[] @relation("invitationRoles")

  @@unique([businessId, name], name: "unique_role_per_business")
  @@index([businessId], name: "idx_role_business")
  @@map("roles")
}

// =====================================
// MULTI-TENANT: MODULE SYSTEM (Odoo-like)
// =====================================
model Module {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "products", "sales", "inventory"
  displayName String?
  description String?
  isActive    Boolean  @default(true)
  uuid        String?  @unique
  syncStatus  String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessModules BusinessModule[]

  @@map("modules")
}

model BusinessModule {
  id         String   @id @default(cuid())
  businessId String
  moduleId   String
  enabled    Boolean  @default(true)
  uuid       String?  @unique
  syncStatus String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation("businessModules", fields: [businessId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleId], name: "unique_business_module")
  @@index([businessId], name: "idx_business_module_business")
  @@map("business_modules")
}

// =====================================
// MULTI-TENANT: BUSINESS TYPE TEMPLATES
// =====================================
model BusinessType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "PHARMACY", "RETAIL_STORE"
  description String?
  isActive    Boolean  @default(true)
  uuid        String?  @unique
  syncStatus  String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules BusinessTypeModule[]
  pages   BusinessTypePage[]

  @@map("business_types")
}

model BusinessTypeModule {
  businessTypeId String
  moduleId       String
  isEnabled      Boolean  @default(true)
  sortOrder      Int      @default(0)
  uuid           String?  @unique
  syncStatus     String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessType BusinessType     @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)
  module       ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([businessTypeId, moduleId])
  @@map("business_type_modules")
}

// Business type → page/resource enablement (canonical replacement for the raw
// business_type_sub_module_permissions table).
model BusinessTypePage {
  businessTypeId String
  pageId         String
  isEnabled      Boolean  @default(true)
  sortOrder      Int      @default(0)
  uuid           String?  @unique
  syncStatus     String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)
  page         ModulePage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([businessTypeId, pageId])
  @@index([pageId])
  @@map("business_type_pages")
}

// =====================================
// BUSINESS SUBSCRIPTION (one per business)
// =====================================
model BusinessSubscription {
  id               String    @id @default(cuid())
  businessId       String    @unique
  planId           String
  status           String    @default("ACTIVE") // Subscription Status: TRIAL, GRACE, ACTIVE, SUSPENDED, EXPIRED, CANCELLED
  billingStatus    String    @default("PENDING") // Billing Status: Paid, Pending
  trialEndsAt      DateTime? // When trial ends (if applicable)
  currentPeriodEnd DateTime? // Current billing period end
  billingProfileId String?
  uuid             String?   @unique
  syncStatus       String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business       Business        @relation("businessSubscription", fields: [businessId], references: [id], onDelete: Cascade)
  plan           Plan            @relation(fields: [planId], references: [id])
  billingProfile BillingProfile? @relation("subscriptionBillingProfile", fields: [billingProfileId], references: [id])

  @@map("business_subscriptions")
}

model BillingProfile {
  id              String   @id @default(cuid())
  userId          String
  businessId      String?
  name            String // Profile name (e.g., "Primary", "Office")
  email           String
  phone           String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  postalCode      String
  country         String   @default("US")
  taxId           String? // Tax ID/VAT number
  companyName     String? // For business billing
  isDefault       Boolean  @default(false)
  paymentMethodId String? // Reference to card_details.id
  uuid            String?  @unique
  syncStatus      String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          ZapeeraUser            @relation("userBillingProfiles", fields: [userId], references: [id], onDelete: Cascade)
  business      Business?              @relation("businessBillingProfiles", fields: [businessId], references: [id], onDelete: Cascade)
  paymentMethod card_details?          @relation("billingProfilePaymentMethod", fields: [paymentMethodId], references: [id])
  subscriptions BusinessSubscription[] @relation("subscriptionBillingProfile")

  @@map("billing_profiles")
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  price             Float
  durationDays      Int
  trialDurationDays Int      @default(14)
  isTrial           Boolean  @default(false)
  maxBranches       Int?
  maxUsers          Int?
  maxCounters       Int?
  trialLimitPerUser Int      @default(1)
  features          Json?
  isActive          Boolean  @default(true)
  // permissionState: UNCONFIGURED (no policy published yet — default deny) or
  // CONFIGURED (a policy was published; zero entitlements = deny all non-core).
  permissionState String @default("UNCONFIGURED")
  policyVersion   Int    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions BusinessSubscription[]
  paymentProofs PaymentProof[]
  entitlements  PlanEntitlement[]      @relation("planEntitlements")

  @@map("platform_plans")
}

model PaymentProof {
  id             String  @id @default(cuid())
  businessId     String
  planId         String
  subscriptionId String? // linked once approved

  amount        Float
  currency      String  @default("PKR")
  method        String // BANK_TRANSFER | EASYPAISA | JAZZCASH
  referenceNote String? // TXN ID, cheque number, etc.

  screenshotUrl  String // relative path: payment-proofs/<filename>
  screenshotHash String? // SHA-256 of file to detect reuse

  status String @default("PENDING") // PENDING | APPROVED | REJECTED

  reviewedBy      String? // adminId
  reviewedAt      DateTime?
  rejectionReason String?

  submissionsToday Int @default(0) // denormalized; enforced in controller

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation("businessPaymentProofs", fields: [businessId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([businessId, status])
  @@index([screenshotHash])
  @@map("payment_proofs")
}

// =====================================
// BACKOFFICE: ADMIN SYSTEM
// =====================================
model BackOfficeUser {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  role        String // SUPER_ADMIN, ADMIN, FINANCE, SUPPORT, HR
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs      BackOfficeActionLog[]
  loginLogs BackOfficeLoginLog[]

  @@map("backoffice_users")
}

model BackOfficeActionLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin BackOfficeUser @relation(fields: [adminId], references: [id])

  @@map("backoffice_action_logs")
}

model BackOfficeLoginLog {
  id        String   @id @default(cuid())
  adminId   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  admin BackOfficeUser @relation(fields: [adminId], references: [id])

  @@map("backoffice_login_logs")
}

model EmailNotification {
  id            String    @id @default(cuid())
  businessId    String?
  userId        String?
  type          String // SUBSCRIPTION_EXPIRY_REMINDER, WELCOME, etc.
  daysRemaining Int?
  status        String    @default("PENDING") // PENDING, SENT, FAILED
  error         String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([businessId], name: "idx_emailNotif_business")
  @@index([userId], name: "idx_emailNotif_user")
  @@index([type], name: "idx_emailNotif_type")
  @@index([status], name: "idx_emailNotif_status")
  @@map("email_notifications")
}

// =====================================
// MODULE HIERARCHY V2 (DATABASE-DRIVEN)
// =====================================
model ModuleDefinition {
  id           String   @id @default(cuid())
  key          String   @unique // "sales", "inventory"
  name         String // "Sales", "Inventory"
  icon         String // "ShoppingCart"
  description  String?
  sortOrder    Int      @default(0)
  parentId     String? // For module groups
  route        String? // "/sales"
  isSidebar    Boolean  @default(true)
  isCore       Boolean  @default(false) // Core = always available
  isActive     Boolean  @default(true)
  moduleSource String   @default("CORE") // CORE, APP, THIRD_PARTY
  uuid         String?  @unique
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessTypeModules BusinessTypeModule[]
  pages               ModulePage[]
  dependencies        ModuleDependency[]       @relation("dependencies")
  dependents          ModuleDependency[]       @relation("dependents")
  businessOverrides   BusinessModuleOverride[]

  @@index([key])
  @@index([isActive])
  @@map("module_definitions")
}

model ModulePage {
  id         String   @id @default(cuid())
  moduleId   String
  key        String // "products", "categories"
  name       String // "Products", "Categories"
  route      String?
  icon       String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  uuid       String?  @unique
  syncStatus String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  module            ModuleDefinition   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rolePermissionsV2 RolePermissionV2[]
  businessTypePages BusinessTypePage[]

  @@unique([moduleId, key])
  @@index([moduleId])
  @@map("module_pages")
}

model Operation {
  id          String   @id @default(cuid())
  key         String   @unique // "read", "create", "update", "delete", "export", "import", "approve", "print"
  name        String
  description String? // Operation description
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  uuid        String?  @unique
  syncStatus  String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissionsV2 RolePermissionV2[]

  @@map("operations")
}

model RolePermissionV2 {
  id           String   @id @default(cuid())
  roleId       String
  operationKey String // "read", "create", "update", "delete", "export", "approve", "print"
  modulePageId String // Specific page/resource within module
  allowed      Boolean  @default(false)
  // Data scope: OWN, ASSIGNED_BRANCH, ALL_BRANCHES, BUSINESS
  scope        String   @default("BUSINESS")
  priority     Int      @default(0) // For conflict resolution
  uuid         String?  @unique
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation("rolePermissionsV2", fields: [roleId], references: [id], onDelete: Cascade)
  operation  Operation  @relation(fields: [operationKey], references: [key])
  modulePage ModulePage @relation(fields: [modulePageId], references: [id], onDelete: Cascade)

  @@unique([roleId, operationKey, modulePageId])
  @@index([roleId])
  @@index([modulePageId])
  @@map("role_permissions_v2")
}

model BusinessModuleOverride {
  id             String   @id @default(cuid())
  businessId     String
  moduleId       String
  enabled        Boolean  @default(true)
  disabledReason String? // "owner_disabled", "testing", "cost_saving"
  notes          String?
  uuid           String?  @unique
  syncStatus     String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business         @relation("businessModuleOverridesV2", fields: [businessId], references: [id], onDelete: Cascade)
  module   ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleId])
  @@index([businessId])
  @@map("business_module_overrides")
}

model ModuleDependency {
  id                String   @id @default(cuid())
  moduleId          String
  dependsOnModuleId String
  isHardDependency  Boolean  @default(true) // true = hard block, false = warning
  uuid              String?  @unique
  syncStatus        String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module    ModuleDefinition @relation("dependencies", fields: [moduleId], references: [id], onDelete: Cascade)
  dependsOn ModuleDefinition @relation("dependents", fields: [dependsOnModuleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, dependsOnModuleId])
  @@index([moduleId])
  @@map("module_dependencies")
}

model PlanEntitlement {
  id               String   @id @default(cuid())
  planId           String
  moduleKey        String // "inventory", "accounting", "payroll"
  pageKey          String? // null = whole-module entitlement; set = page/resource level
  entitlementLevel String   @default("FULL") // FULL, LIMITED, NONE
  uuid             String?  @unique
  syncStatus       String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plan Plan @relation("planEntitlements", fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleKey, pageKey])
  @@index([planId])
  @@map("plan_entitlements")
}

// Policy audit trail for plan / role / business-type / override / subscription
// policy mutations. Written in the same transaction as the mutation.
model PolicyAuditLog {
  id            String   @id @default(cuid())
  entityType    String // PLAN, ROLE, BUSINESS_TYPE, BUSINESS_OVERRIDE, SUBSCRIPTION, MEMBERSHIP
  entityId      String
  actorId       String?
  action        String // PUBLISH_POLICY, UPDATE, ASSIGN, REVOKE, ...
  before        Json?
  after         Json?
  policyVersion Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("policy_audit_logs")
}

// â”€â”€â”€ Backoffice: Support Tickets â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model SupportTicket {
  id           String   @id @default(cuid())
  businessId   String?
  userId       String?
  subject      String
  description  String
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedTo   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([businessId])
  @@map("support_tickets")
}

// One message in a support-ticket thread. The ticket's original description
// is the opening message; replies from the tenant user and from backoffice
// admins both live here. authorId is a ZapeeraUser id when authorType is
// TENANT and a BackOfficeUser id when authorType is ADMIN.
model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorType String   @default("TENANT") // TENANT, ADMIN
  authorId   String?
  body       String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// ─── Backoffice: Content Pages ──────────────────────────────────────────────
// Minimal CMS: platform-managed static pages (legal, help, landing copy)
// edited from the backoffice and served publicly when PUBLISHED.
model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  status    String   @default("DRAFT") // DRAFT, PUBLISHED
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("content_pages")
}

// â”€â”€â”€ Backoffice: Announcements â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String
  type       String   @default("INFO") // INFO, WARNING, MAINTENANCE, UPDATE
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@map("announcements")
}

// â”€â”€â”€ Backoffice: Feature Flags â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// â”€â”€â”€ Notifications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Persisted notifications for users (in-app notification feed)
model Notification {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  type       String   // e.g. sale_created, subscription_expiry, invitation_received, staff_added, payment_approved, inventory_low, system_announcement
  title      String
  body       String
  actionUrl  String?  // deep link to relevant page
  metadata   String?  // JSON string for extra data
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     ZapeeraUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_notification_user")
  @@index([userId, read], name: "idx_notification_user_read")
  @@index([businessId], name: "idx_notification_business")
  @@index([type], name: "idx_notification_type")
  @@index([createdAt], name: "idx_notification_created")
  @@map("notifications")
}

// Per-user notification preference for each category
// One row per user per category. Missing rows = enabled (default).
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String   // sale, inventory, subscription, invitation, staff, billing, system
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category], name: "unique_notification_pref_user_category")
  @@index([userId], name: "idx_notif_pref_user")
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Backoffice module-permission matrix tables.
// Originally created by the backoffice service via raw SQL and missing from
// this schema, which made the startup schema-heal (prisma db push) propose
// dropping them. Modeled faithfully (columns, defaults, PK and the exact
// unique-constraint names match the live database) so db push is a no-op.
// ---------------------------------------------------------------------------

model PlanModulePermission {
  id         String    @id @default(cuid())
  planId     String
  moduleName String
  enabled    Boolean   @default(false)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@unique([planId, moduleName], map: "plan_module_permissions_planId_moduleName_key")
  @@map("plan_module_permissions")
}

model PlanSubModulePermission {
  id           String    @id @default(cuid())
  planId       String
  moduleName   String
  subModuleKey String
  enabled      Boolean   @default(true)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now()) @updatedAt

  @@unique([planId, moduleName, subModuleKey], map: "plan_sub_module_permissions_planId_moduleName_subModuleKey_key")
  @@map("plan_sub_module_permissions")
}

model RoleModulePermission {
  id         String    @id @default(cuid())
  roleName   String
  moduleName String
  enabled    Boolean   @default(false)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@unique([roleName, moduleName], map: "role_module_permissions_roleName_moduleName_key")
  @@map("role_module_permissions")
}

model RoleSubModulePermission {
  id           String    @id @default(cuid())
  roleName     String
  moduleName   String
  subModuleKey String
  enabled      Boolean   @default(true)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @default(now()) @updatedAt

  @@unique([roleName, moduleName, subModuleKey], map: "role_sub_module_permissions_roleName_moduleName_subModuleKe_key")
  @@map("role_sub_module_permissions")
}

model BusinessTypeSubModulePermission {
  id             String    @id @default(cuid())
  businessTypeId String
  moduleName     String
  subModuleKey   String
  enabled        Boolean   @default(true)
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @default(now()) @updatedAt

  @@unique([businessTypeId, moduleName, subModuleKey], map: "business_type_sub_module_perm_businessTypeId_moduleName_sub_key")
  @@map("business_type_sub_module_permissions")
}

// ─── Clinic pack (Wave C4) ───────────────────────────────────────────
// Clinics previously had NO patient/doctor/appointment modules at all
// (billing + supplies inventory only). This pack adds Patient-Lite,
// Doctors, the Appointments/OPD token queue, visit billing through
// the normal sale engine, and doctor-share settlement.

// Patient-Lite: the clinic's own register of the people it treats.
// Deliberately separate from Customer (the sales/khata register): a
// patient is a clinical record. A visit invoice therefore carries no
// customerId — khata/loyalty stay POS decisions, not clinic ones.
model Patient {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  phone     String?
  age       Int?
  gender    String?
  cnic      String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Business      @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([companyId], name: "idx_patient_company")
  @@index([branchId], name: "idx_patient_branch")
  @@index([phone], name: "idx_patient_phone")
  @@map("patients")
}

// A doctor who sees patients at the clinic. consultationFee is the
// standard fee billed per visit; sharePercent is the DOCTOR's share
// of that fee (the clinic keeps the rest). Both are only DEFAULTS:
// at visit completion the fee actually charged and the share it
// produced are snapshotted onto the Appointment, and settlement
// reports read the snapshots — editing a doctor never rewrites
// history. serviceProductId points at the auto-ensured non-stock
// Product ("Consultation — Dr <name>", isService) whose sale line
// carries the fee on the visit invoice; the fee never touches stock.
model Doctor {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  specialization   String?
  phone            String?
  consultationFee  Float    @default(0)
  sharePercent     Float    @default(0)
  serviceProductId String?
  isActive         Boolean  @default(true)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Business           @relation(fields: [companyId], references: [id])
  serviceProduct Product?           @relation("DoctorServiceProduct", fields: [serviceProductId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  settlements    DoctorSettlement[]

  @@index([companyId], name: "idx_doctor_company")
  @@index([serviceProductId], name: "idx_doctor_service_product")
  @@map("doctors")
}

// One OPD visit. tokenNumber is the patient's place in the doctor's
// queue for the day: a per (doctor, appointmentDate) sequence the
// server assigns at booking (1, 2, 3, …), unique per doctor+day.
// appointmentDate is stored normalized to UTC midnight of the clinic
// day. Status flow:
//   BOOKED → CHECKED_IN → IN_VISIT → COMPLETED
//   BOOKED | CHECKED_IN → CANCELLED | NO_SHOW
// Completion (POST /appointments/:id/complete-visit) creates the
// visit invoice (a normal Sale), links it via saleId, links the C1
// Prescription it wrote via prescriptionId, and snapshots
// feeCharged + doctorShareAmount so settlement reporting never
// re-derives money from the doctor's current fee/share.
model Appointment {
  id                String    @id @default(cuid())
  companyId         String
  branchId          String?
  patientId         String
  doctorId          String
  appointmentDate   DateTime
  tokenNumber       Int
  status            String    @default("BOOKED") // BOOKED | CHECKED_IN | IN_VISIT | COMPLETED | CANCELLED | NO_SHOW
  reason            String?
  notes             String?
  saleId            String?
  prescriptionId    String?
  feeCharged        Float?
  doctorShareAmount Float?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company      Business      @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@unique([doctorId, appointmentDate, tokenNumber], name: "appt_doctor_date_token")
  @@index([companyId], name: "idx_appointment_company")
  @@index([branchId], name: "idx_appointment_branch")
  @@index([patientId], name: "idx_appointment_patient")
  @@index([doctorId, appointmentDate], name: "idx_appointment_doctor_date")
  @@index([status], name: "idx_appointment_status")
  @@map("appointments")
}

// A payout of doctor-share money to a doctor. periodFrom/periodTo
// record the earning window the payout is meant to cover. The
// settlement report's "outstanding" for a window is: doctor share
// earned in the window (Appointment snapshots) minus settlements
// PAID in the window (by settlement createdAt) — deliberately
// simple, documented semantics; see doctor.controller.
model DoctorSettlement {
  id         String   @id @default(cuid())
  companyId  String
  doctorId   String
  periodFrom DateTime
  periodTo   DateTime
  amount     Float
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Business @relation(fields: [companyId], references: [id])
  doctor  Doctor   @relation(fields: [doctorId], references: [id])

  @@index([companyId], name: "idx_doctor_settlement_company")
  @@index([doctorId], name: "idx_doctor_settlement_doctor")
  @@index([createdAt], name: "idx_doctor_settlement_createdAt")
  @@map("doctor_settlements")
}
