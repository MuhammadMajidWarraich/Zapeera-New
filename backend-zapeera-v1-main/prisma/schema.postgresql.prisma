  billingStatus    String    @default("PENDING") // Billing Status: Paid, Pending
  trialEndsAt      DateTime? // When trial ends (if applicable)
  currentPeriodEnd DateTime? // Current billing period end
  billingProfileId String?
  uuid             String?   @unique
  syncStatus       String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business       Business        @relation("businessSubscription", fields: [businessId], references: [id], onDelete: Cascade)
  plan           Plan            @relation(fields: [planId], references: [id])
  billingProfile BillingProfile? @relation("subscriptionBillingProfile", fields: [billingProfileId], references: [id])

  @@map("business_subscriptions")
}

model BillingProfile {
  id              String   @id @default(cuid())
  userId          String
  businessId      String?
  name            String // Profile name (e.g., "Primary", "Office")
  email           String
  phone           String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  postalCode      String
  country         String   @default("US")
  taxId           String? // Tax ID/VAT number
  companyName     String? // For business billing
  isDefault       Boolean  @default(false)
  paymentMethodId String? // Reference to card_details.id
  uuid            String?  @unique
  syncStatus      String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          ZapeeraUser            @relation("userBillingProfiles", fields: [userId], references: [id], onDelete: Cascade)
  business      Business?              @relation("businessBillingProfiles", fields: [businessId], references: [id], onDelete: Cascade)
  paymentMethod card_details?          @relation("billingProfilePaymentMethod", fields: [paymentMethodId], references: [id])
  subscriptions BusinessSubscription[] @relation("subscriptionBillingProfile")

  @@map("billing_profiles")
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  price             Float
  durationDays      Int
  trialDurationDays Int      @default(14)
  isTrial           Boolean  @default(false)
  maxBranches       Int?
  maxUsers          Int?
  maxCounters       Int?
  trialLimitPerUser Int      @default(1)
  features          Json?
  isActive          Boolean  @default(true)
  // permissionState: UNCONFIGURED (no policy published yet — default deny) or
  // CONFIGURED (a policy was published; zero entitlements = deny all non-core).
  permissionState String @default("UNCONFIGURED")
  policyVersion   Int    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions BusinessSubscription[]
  paymentProofs PaymentProof[]
  entitlements  PlanEntitlement[]      @relation("planEntitlements")

  @@map("platform_plans")
}

model PaymentProof {
  id             String  @id @default(cuid())
  businessId     String
  planId         String
  subscriptionId String? // linked once approved

  amount        Float
  currency      String  @default("PKR")
  method        String // BANK_TRANSFER | EASYPAISA | JAZZCASH
  referenceNote String? // TXN ID, cheque number, etc.

  screenshotUrl  String // relative path: payment-proofs/<filename>
  screenshotHash String? // SHA-256 of file to detect reuse

  status String @default("PENDING") // PENDING | APPROVED | REJECTED

  reviewedBy      String? // adminId
  reviewedAt      DateTime?
  rejectionReason String?

  submissionsToday Int @default(0) // denormalized; enforced in controller

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation("businessPaymentProofs", fields: [businessId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([businessId, status])
  @@index([screenshotHash])
  @@map("payment_proofs")
}


// =====================================
// AFFILIATE PROGRAM
// =====================================
// An affiliate is a normal registered user (ZapeeraUser) with an
// Affiliate profile. Signup attribution (?ref=CODE) is captured on the
// user (signupRefCode) and converted into an AffiliateReferral when the
// user's FIRST business is created (see company.controller createCompany
// + affiliate.util attributeFirstBusinessIfReferred). Commissions accrue
// only on real money-in moments (payment-proof approval, non-trial
// backoffice plan assignment) and are deduplicated by the UNIQUE
// sourceRef — a re-approval or double-submit can never double-accrue.
model Affiliate {
  id              String   @id @default(cuid())
  userId          String   @unique
  code            String   @unique // public referral code, e.g. "ZAP-8K2QX4MN" without prefix stored as 8 chars
  status          String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  commissionRate  Float? // per-affiliate override (percent); null = global default
  payoutDetails   Json? // { method: BANK_TRANSFER|JAZZCASH|EASYPAISA, accountTitle, accountNumber, bankName? }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        ZapeeraUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  @@index([status])
  @@map("affiliates")
}

model AffiliateReferral {
  id             String   @id @default(cuid())
  affiliateId    String
  businessId     String   @unique // a business is attributed to at most one affiliate, once
  referredUserId String? // the user who signed up with the code (business creator)
  createdAt      DateTime @default(now())

  affiliate    Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  referredUser ZapeeraUser? @relation("referralReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@map("affiliate_referrals")
}

model AffiliateCommission {
  id           String    @id @default(cuid())
  affiliateId  String
  businessId   String
  sourceRef    String    @unique // e.g. "payment_proof:<proofId>" | "subscription_assign:<subId>:<periodEndDate>"
  basisAmount  Float // the amount actually paid (proof amount / plan price)
  rateApplied  Float // percent applied (affiliate override ?? global default)
  amount       Float // basisAmount * rateApplied / 100, rounded to 2dp
  status       String    @default("PENDING") // PENDING | APPROVED | PAID | VOID
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  paidAt       DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@index([businessId])
  @@map("affiliate_commissions")
}

model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliateId String
  amount      Float
  status      String    @default("REQUESTED") // REQUESTED | PAID | REJECTED
  note        String?
  processedBy String? // BackOfficeUser id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@map("affiliate_payouts")
}

// =====================================
// BACKOFFICE: ADMIN SYSTEM
