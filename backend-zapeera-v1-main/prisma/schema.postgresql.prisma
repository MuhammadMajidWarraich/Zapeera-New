// =====================================
// MULTI-TENANT: RBAC SYSTEM
// =====================================
model Role {
  id         String   @id @default(cuid())
  businessId String? // NULL for global/platform roles, set for business-specific
  name       String
  description String?
  isSystem    Boolean  @default(false) // OWNER/MANAGER/CASHIER presets are protected
  isActive    Boolean  @default(true)
  // permissionState: UNCONFIGURED (no policy published yet — default deny) or
  // CONFIGURED (a policy was published; zero grants = deny all non-core).
  permissionState String @default("UNCONFIGURED")
  policyVersion   Int    @default(0)
  uuid         String?  @unique
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business? @relation("roles", fields: [businessId], references: [id], onDelete: Cascade)

  permissionsV2 RolePermissionV2[]   @relation("rolePermissionsV2")
  memberships   Membership[]
  invitations   BusinessInvitation[] @relation("invitationRoles")

  @@unique([businessId, name], name: "unique_role_per_business")
  @@index([businessId], name: "idx_role_business")
  @@map("roles")
}

