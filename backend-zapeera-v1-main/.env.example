PORT=4200
NODE_ENV=development
USE_POSTGRESQL=false

# Required for API authentication. Use a long random value in real environments.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Web/PostgreSQL mode. Required only when USE_POSTGRESQL=true.
POSTGRESQL_URL=
REMOTE_DATABASE_URL=
PG_CONNECTION_LIMIT=10
PG_POOL_TIMEOUT=15

# Frontend origin for CORS.
FRONTEND_URL=http://localhost:4100

# ==========================================
# Email Configuration (choose one provider)
# ==========================================

# PRIMARY: Resend (recommended for production)
# Get API key from https://resend.com (free: 100 emails/day)
# No credit card required. Add and verify your domain there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@zapeera.com

# FALLBACK: SMTP (Gmail, Outlook, etc.)
# For Gmail: Enable 2FA, generate App Password at myaccount.google.com/apppasswords
# Use port 465 with secure=true, or port 587 with secure=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# VOICE ASSISTANT AI LAYER (optional — free tiers only)
# The rule parser always runs first; the AI layer only handles commands
# the parser cannot. Leave VOICE_AI_API_KEY empty to disable the AI
# layer entirely (assistant stays parser-only). The key is used ONLY by
# this backend proxy — it is never sent to the frontend.
# Primary (recommended): Groq free developer tier — no credit card,
# never trains on customer data. Key from https://console.groq.com
VOICE_AI_PROVIDER=groq
VOICE_AI_API_KEY=
VOICE_AI_MODEL=llama-3.1-8b-instant
# Fallback (optional): Cloudflare Workers AI free allocation —
# also no training on customer content. Needs the account id.
VOICE_AI_FALLBACK_PROVIDER=cloudflare
VOICE_AI_FALLBACK_API_KEY=
VOICE_AI_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
VOICE_AI_FALLBACK_ACCOUNT_ID=
# Per-plan monthly token quotas + platform daily cap are NOT env vars:
# they are backoffice-editable (Backoffice → Settings → Voice AI),
# stored in the Settings table under owner 'global_voice_ai'.

# LOCAL DEVELOPMENT: Mailpit (auto-captures emails, no real sending)
# Docker: docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
# View captured emails at http://localhost:8025
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# ==========================================
# Integrations framework (AES-256-GCM key)
# ==========================================
# REQUIRED before any integration can connect. The key encrypts
# third-party credentials stored in IntegrationConnection rows — without
# it, POST /api/integrations/:provider/connect fails loudly with
# INTEGRATION_ENCRYPTION_NOT_CONFIGURED instead of storing plaintext.
# Generate with: openssl rand -hex 32  (64 hex characters, 32 bytes)
# Keep it out of git and out of chat. ROTATION IS NOT YET SUPPORTED:
# changing this key makes previously stored credentials undecryptable
# (affected connections show status "error" and must be reconnected).
INTEGRATION_ENCRYPTION_KEY=

# ==========================================
# Shopify integration (feature/integration-shopify)
# ==========================================
# OAuth app credentials for the Shopify connect flow (Partner Dashboard /
# Dev Dashboard -> the Zapeera app -> Settings -> Credentials). The API
# secret is ALSO the webhook signing secret (Shopify signs webhooks with
# the app's client secret). Without these, OAuth install + webhooks are
# unavailable — the Settings dialog still accepts a pasted custom-app
# Admin API access token (offline, shpat_...).
# SHOPIFY_APP_URL = the public base URL of THIS backend (the OAuth
# redirect_uri host). It must be registered in the app's redirect URLs
# as: <SHOPIFY_APP_URL>/api/v1/integrations/shopify/oauth/callback
# SHOPIFY_OAUTH_RETURN_URL = where the merchant lands after the OAuth
# callback (the frontend Settings page). Optional — without it the
# callback answers with a plain "connected" page.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_OAUTH_RETURN_URL=
# JazzCash payment rail (feature/integration-jazzcash)
# JAZZCASH_ENVIRONMENT: sandbox (default) or production. Sandbox is the
# safe default — production moves REAL money and needs live merchant
# credentials. Never set production in a dev/test environment.
# JAZZCASH_RETURN_URL: the HTTPS URL JazzCash POSTs card/OTC
# page-redirection results to. It MUST match the Return URL registered
# in the JazzCash merchant portal when the sandbox/live credentials were
# generated. For this deployment:
#   https://<zapeera-host>/api/v1/integrations/jazzcash/return
# The IPN listener lives at the same host:
#   https://<zapeera-host>/api/v1/integrations/jazzcash/ipn
# (register BOTH URLs in the JazzCash portal; the IPN listener is what
# confirms OTC/card payments that never come back through the browser).
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_RETURN_URL=
# PostEx courier integration (feature/integration-postex). PostEx publishes
# NO public API docs — the API base URL below comes from the details PostEx
# issues with your merchant account (client ID / client secret / company
# code are entered in Settings → Integrations). Until the base URL is set,
# PostEx connect fails closed with a plain-language error. The endpoint
# paths in src/integrations/postex/client.ts are UNVERIFIED placeholders —
# confirm them against the merchant-issued docs at onboarding. Set
# POSTEX_API_ENVIRONMENT=sandbox (and POSTEX_SANDBOX_API_BASE_URL) to test
# against the PostEx sandbox before going live.
POSTEX_API_ENVIRONMENT=production
POSTEX_API_BASE_URL=
POSTEX_SANDBOX_API_BASE_URL=
# Google Sheets integration (feature/integration-google-sheets) — OAuth
# 2.0 web-application client from Google Cloud Console, with the Google
# Sheets API enabled. The redirect URI must be registered EXACTLY for
# that client (Authorized redirect URIs) — it is the callback the
# merchant's browser returns to after consenting on Google's page.
# Production: https://<api-host>/api/v1/integrations/google-sheets/oauth/callback
# Local dev:  http://localhost:<api-port>/api/v1/integrations/google-sheets/oauth/callback
# Scopes requested at consent: spreadsheets + drive.file (narrowest
# Drive scope — Zapeera only ever sees files it created). Tokens are
# stored encrypted with INTEGRATION_ENCRYPTION_KEY and refreshed
# silently; the merchant disconnects from Settings → Integrations.
# Service-account alternative (no per-user consent): connect via the API
# with { serviceAccountEmail, serviceAccountPrivateKey } — the merchant
# must share the target spreadsheet with the service-account email.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=
