{
  "name": "zapeera-backend",
  "version": "1.0.0",
  "description": "Business Management Platform Backend with Offline/Online Support",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/ensure-schema-sqlite.js && ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:web": "node scripts/ensure-schema-postgresql.js && cross-env USE_POSTGRESQL=true ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:live": "node scripts/ensure-schema-postgresql.js && cross-env USE_POSTGRESQL=true ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:electron": "node scripts/ensure-schema-sqlite.js && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "build:prod": "npm run setup:web && npm run build",
    "build:prod:force": "npm run setup:web && tsc --skipLibCheck",
    "start": "node dist/server.js",
    "start:web": "cross-env USE_POSTGRESQL=true node dist/server.js",
    "start:online": "cross-env NODE_ENV=production REMOTE_DATABASE_URL=\"postgresql://user:pass@host:port/db\" node start-server.js start",
    "start:offline": "cross-env NODE_ENV=production node start-server.js start",
    "sync": "ts-node scripts/sync.ts",
    "test:staff": "ts-node scripts/test-staff-flow.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "cross-env DATABASE_URL=\"file:$HOME/.zapeera/data/zapeera.db\" prisma studio",
    "db:switch-sqlite": "node scripts/switch-schema.js sqlite && npx prisma generate",
    "db:switch-postgresql": "node scripts/switch-schema.js postgres && npx prisma generate",
    "setup:electron": "node scripts/switch-schema.js sqlite && (npx prisma generate || echo 'Prisma client already generated')",
    "setup:web": "node scripts/switch-schema.js postgres && npx prisma generate",
    "db:add-sync-columns": "ts-node scripts/add-sync-columns-to-postgresql.ts",
    "db:reset-postgresql": "ts-node scripts/reset-postgresql.ts",
    "fix:sqlite": "node scripts/fix-sqlite-setup.js",
    "seed:sqlite": "ts-node scripts/seed-sqlite.ts",
    "seed:cloud-test": "cross-env DATABASE_URL=\"file:./tests/cloud-test.db\" ts-node scripts/seed-cloud-test.ts",
    "reset:cloud-test": "ts-node scripts/reset-cloud-test-db.ts",
    "test:sync": "cross-env DATABASE_URL=\"file:./tests/cloud-test.db\" jest --testPathPattern='sync/cloud-sync'",
    "test:sync:reset": "npm run reset:cloud-test && npm run seed:cloud-test -- --force",
    "dev:cloud-test": "cross-env DATABASE_URL=\"file:./tests/cloud-test.db\" ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:local": "cross-env DATABASE_URL=\"file:./zapeera-dev.db\" ts-node-dev --respawn --transpile-only src/server.ts",
    "start:pm2": "pm2 start pm2.config.js",
    "stop:pm2": "pm2 stop zapeera-backend",
    "restart:pm2": "pm2 restart zapeera-backend"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.5",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.0",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.5.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "jest": "^29.5.0",
    "prisma": "^6.19.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3"
  }
}
