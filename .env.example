# ============================================================================
# Zapeera single-host stack — environment template
# Copy to ".env" in the repo root and fill in real values:  cp .env.example .env
# .env is gitignored — NEVER commit real secrets.
# Placeholders below are safe examples only, not real credentials.
# ============================================================================

# ----------------------------------------------------------------------------
# Site addresses (Caddy) — the ONLY place the public hostnames live.
# Test phase uses seikho.online subdomains. To move to Zapeera's own domain
# later: change these four + FRONTEND_URL/CORS_ORIGINS/VITE_CLOUD_API_URL,
# update DNS, re-run `docker compose up -d --build`. Nothing else changes.
# ----------------------------------------------------------------------------
FRONTEND_DOMAIN=zapeera.seikho.online
API_DOMAIN=api.zapeera.seikho.online
# (Let's Encrypt certificates are issued automatically by Caddy — no
# account or email needed. See the note at the top of Caddyfile.)

# ----------------------------------------------------------------------------
# PostgreSQL (compose service "postgres")
# docker-compose.yml composes the backend's DATABASE_URL from these:
#   postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
# ----------------------------------------------------------------------------
POSTGRES_USER=zapeera
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=zapeera

# Full override (optional): set this ONLY if the database is NOT the compose
# postgres service (e.g. restoring against an external PostgreSQL). Leave
# commented for the single-host stack.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----------------------------------------------------------------------------
# Backend (compose service "backend")
# ----------------------------------------------------------------------------
# REQUIRED: long random string used to sign JWTs. Generate one with:
#   openssl rand -hex 48
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
PG_CONNECTION_LIMIT=10
PG_POOL_TIMEOUT=15

# Public origin of the web app — used for CORS and for links in emails
# (e.g. password-reset links). Must match FRONTEND_DOMAIN.
FRONTEND_URL=https://zapeera.seikho.online
# Extra allowed origins, comma-separated (the api subdomain is for direct
# API clients; same-origin web traffic needs no CORS at all).
CORS_ORIGINS=https://zapeera.seikho.online,https://api.zapeera.seikho.online

# One-time token for the initial backoffice/admin setup endpoint, if used.
ADMIN_SETUP_TOKEN=change-me-random-token

# OCR service URL — the compose file sets this to http://ocr:8000 for the
# backend container automatically; only set it here for non-Docker runs.
# OCR_SERVICE_URL=http://localhost:8000

# --- Email: Resend (recommended — OCI blocks outbound SMTP ports) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# From-address (domain must be verified in Resend). Until a domain is
# verified, use Resend's onboarding sender or leave email features off.
RESEND_FROM_EMAIL=noreply@your-verified-domain.example
# Generic fallbacks the codebase also reads:
# EMAIL_FROM=noreply@your-verified-domain.example
# FROM_EMAIL=noreply@your-verified-domain.example

# --- Email: SMTP fallback (optional; leave empty when using Resend) ---
# NOTE: Oracle Cloud blocks outbound 25/465/587 by default — SMTP will not
# work from the VM unless an egress rule/release is arranged. Prefer Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Legacy aliases the codebase also reads:
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASSWORD=

# Local mail catcher (dev only — leave unset in production)
# MAILPIT_HOST=localhost
# MAILPIT_PORT=1025

# Default pharmacy identity used in seeds/receipts (optional)
DEFAULT_PHARMACY_NAME=Zapeera Pharmacy
DEFAULT_PHARMACY_EMAIL=info@example.com
DEFAULT_PHARMACY_PHONE=
DEFAULT_PHARMACY_LICENSE=
COMPANY_EMAIL=
BRANCH_EMAIL=

# Rate limiting / misc backend tuning (optional — defaults exist in code)
# AUTH_RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=300
# RATE_LIMIT_WINDOW_MS=900000
# SESSION_TTL_MINUTES=10080
# MAX_FILE_SIZE=10485760
# ENABLE_REQUEST_LOGGING=true
# ENABLE_SUBSCRIPTION_REMINDERS=true
# LOG_LEVEL=info
# APP_NAME=Zapeera

# ----------------------------------------------------------------------------
# Frontend build-time values (baked into the SPA at `docker compose build`)
# Relative /api URLs are what make the build domain-portable — keep them.
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_SSE_BASE_URL=/api
# Absolute API URL, used only where an absolute URL is unavoidable
# (desktop/cloud config display, Capacitor). Must match API_DOMAIN.
VITE_CLOUD_API_URL=https://api.zapeera.seikho.online/api
VITE_APP_NAME=Zapeera
VITE_APP_VERSION=1.0.0
# Support contact shown in the UI (cosmetic; set real values when ready)
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_SUPPORT_PHONE=
# VITE_WHATSAPP_URL=
# VITE_CONTACT_URL=https://zapeera.seikho.online/contact
