# Mobile (Capacitor) build configuration — loaded by `vite build --mode mobile`.
#
# Unlike the web build (same-origin, relative /api behind the reverse proxy)
# and the desktop build (embedded local server), the Capacitor app runs
# inside a WebView served from https://localhost, so every API base MUST be
# the absolute cloud API URL — a relative /api would resolve against the
# WebView origin and never reach the backend.
#
# Current deployment host (2026-10-21): the single-host test deployment
# under seikho.online, same cloud API the desktop app uses.
VITE_API_BASE_URL=https://api.zapeera.seikho.online/api
VITE_CLOUD_API_URL=https://api.zapeera.seikho.online/api
VITE_SSE_BASE_URL=https://api.zapeera.seikho.online/api
VITE_API_URL=https://api.zapeera.seikho.online/api
VITE_BACKOFFICE_API_URL=https://api.zapeera.seikho.online/api/backoffice
