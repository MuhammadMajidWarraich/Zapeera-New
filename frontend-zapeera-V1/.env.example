# ======================================
# APPLICATION CONFIGURATION
# ======================================

# API Configuration (local embedded backend for desktop, same-origin for web)
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000
VITE_EMBEDDED_PORT=4201

# Build target: web, desktop, backoffice
# Set via CLI during build (e.g., VITE_APP_TARGET=desktop npm run build)
# VITE_APP_TARGET=web

# Cloud API Configuration (absolute URL for cloud operations from desktop)
# Desktop requires this for first-time auth, sync, membership validation, etc.
# Development: VITE_CLOUD_API_URL=http://127.0.0.1:4200/api
# Production:  VITE_CLOUD_API_URL=https://api.zapeera.com/api
VITE_CLOUD_API_URL=
VITE_CLOUD_API_TIMEOUT=15000

# Backoffice API Configuration
# VITE_BACKOFFICE_API_URL=/api/backoffice

# App Configuration
VITE_APP_NAME=Zapeera
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=true

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ITEMS_PER_PAGE=10

# Desktop: Proxy target (Vite dev server proxies /api to this URL)
# For desktop dev: VITE_PROXY_TARGET=http://127.0.0.1:4201
# For cloud dev:   VITE_PROXY_TARGET=http://127.0.0.1:4200
# VITE_PROXY_TARGET=http://127.0.0.1:4200

# Optional Electron sync.
# Leave blank for offline-only desktop builds. Configure in your build/deployment
# environment when remote sync is required; never hardcode credentials in source.
ZAPEERA_REMOTE_DATABASE_URL=
REMOTE_DATABASE_URL=

# Production Configuration (uncomment and modify for production)
# VITE_API_BASE_URL=https://api.zapeera.com/api
# VITE_CLOUD_API_URL=https://api.zapeera.com/api
# VITE_DEBUG_MODE=false
# VITE_LOG_LEVEL=error
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG_LOGS=false
