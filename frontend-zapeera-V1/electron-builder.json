{
  "appId": "com.zapeera.desktop",
  "productName": "Zapeera",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "buildDependenciesFromSource": false,
  "npmRebuild": true,
  "forceCodeSigning": false,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/express/**/*",
    "node_modules/cors/**/*",
    "node_modules/sql.js/**/*",
    "node_modules/body-parser/**/*",
    "node_modules/cookie-parser/**/*",
    "node_modules/accepts/**/*",
    "node_modules/array-flatten/**/*",
    "node_modules/content-disposition/**/*",
    "node_modules/content-type/**/*",
    "node_modules/cookie/**/*",
    "node_modules/cookie-signature/**/*",
    "node_modules/debug/**/*",
    "node_modules/depd/**/*",
    "node_modules/destroy/**/*",
    "node_modules/encodeurl/**/*",
    "node_modules/escape-html/**/*",
    "node_modules/etag/**/*",
    "node_modules/finalhandler/**/*",
    "node_modules/fresh/**/*",
    "node_modules/http-errors/**/*",
    "node_modules/merge-descriptors/**/*",
    "node_modules/methods/**/*",
    "node_modules/mime/**/*",
    "node_modules/ms/**/*",
    "node_modules/on-finished/**/*",
    "node_modules/parseurl/**/*",
    "node_modules/path-to-regexp/**/*",
    "node_modules/proxy-addr/**/*",
    "node_modules/qs/**/*",
    "node_modules/range-parser/**/*",
    "node_modules/raw-body/**/*",
    "node_modules/safe-buffer/**/*",
    "node_modules/safer-buffer/**/*",
    "node_modules/send/**/*",
    "node_modules/serve-static/**/*",
    "node_modules/setprototypeof/**/*",
    "node_modules/statuses/**/*",
    "node_modules/type-is/**/*",
    "node_modules/unpipe/**/*",
    "node_modules/utils-merge/**/*",
    "node_modules/vary/**/*",
    "node_modules/bytes/**/*",
    "node_modules/iconv-lite/**/*",
    "node_modules/inherits/**/*",
    "node_modules/media-typer/**/*",
    "node_modules/mime-types/**/*",
    "node_modules/mime-db/**/*",
    "node_modules/forwarded/**/*",
    "node_modules/ipaddr.js/**/*",
    "node_modules/toidentifier/**/*",
    "node_modules/ee-first/**/*",
    "node_modules/object-assign/**/*",
    "node_modules/side-channel/**/*",
    "node_modules/call-bind/**/*",
    "node_modules/get-intrinsic/**/*",
    "node_modules/has-symbols/**/*",
    "node_modules/function-bind/**/*",
    "node_modules/hasown/**/*",
    "node_modules/pg/**/*",
    "node_modules/pg-connection-string/**/*",
    "node_modules/pg-pool/**/*",
    "node_modules/pg-protocol/**/*",
    "node_modules/pg-types/**/*",
    "node_modules/pgpass/**/*",
    "node_modules/postgres-array/**/*",
    "node_modules/postgres-bytea/**/*",
    "node_modules/postgres-date/**/*",
    "node_modules/postgres-interval/**/*",
    "node_modules/buffer-writer/**/*",
    "node_modules/packet-reader/**/*",
    "node_modules/@prisma/**/*",
    "node_modules/bcryptjs/**/*",
    "node_modules/jsonwebtoken/**/*",
    "node_modules/joi/**/*",
    "node_modules/compression/**/*",
    "node_modules/helmet/**/*",
    "node_modules/morgan/**/*",
    "node_modules/dotenv/**/*",
    "node_modules/express-rate-limit/**/*"
  ],
  "extraResources": [
    {
      "from": "dist",
      "to": "zapeera-frontend/dist",
      "filter": ["**/*"]
    },
    {
      "from": "../backend-zapeera-v1-main/dist",
      "to": "zapeera-backend/dist",
      "filter": ["**/*"]
    },
    {
      "from": "../backend-zapeera-v1-main/node_modules",
      "to": "zapeera-backend/node_modules",
      "filter": [
        "**/*",
        "!prisma/**",
        "!typescript/**",
        "!@babel/**",
        "!.cache/**",
        "!jest/**",
        "!ts-jest/**",
        "!ts-node/**",
        "!ts-node-dev/**",
        "!cross-env/**",
        "!caniuse-lite/**",
        "!@types/**",
        "!react-dom/**",
        "!js-beautify/**",
        "!@aws-sdk/**",
        "!handlebars/**",
        "!leveldown/**"
      ]
    },
    {
      "from": "../backend-zapeera-v1-main/prisma",
      "to": "zapeera-backend/prisma",
      "filter": ["schema.prisma"]
    }
  ],
  "asarUnpack": [
    "**/*.dll",
    "**/*.node",
    "**/ffmpeg*",
    "**/*.exe",
    "**/better-sqlite3/**/*",
    "**/.prisma/**/*",
    "**/@prisma/**/*",
    "zapeera-backend/node_modules/@prisma/**/*",
    "zapeera-backend/node_modules/.prisma/**/*",
    "zapeera-backend/node_modules/better-sqlite3/**/*",
    "zapeera-backend/node_modules/@prisma/client/**/*",
    "zapeera-backend/node_modules/@prisma/engines/**/*"
  ],
  "asar": true,
  "compression": "store",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icons/icon.ico",
    "signingHashAlgorithms": [],
    "verifyUpdateCodeSignature": false,
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": false,
    "allowElevation": false,
    "installerIcon": "public/icons/icon.ico",
    "uninstallerIcon": "public/icons/icon.ico",
    "installerHeaderIcon": "public/icons/icon.ico",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Zapeera",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "menuCategory": "Business",
    "installerLanguages": ["en_US"],
    "displayLanguageSelector": false,
    "warningsAsErrors": false,
    "perMachine": false,
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "public/icons/icon.icns",
    "category": "public.app-category.business"
  },
  "dmg": {
    "title": "${productName} ${version}",
    "icon": "public/icons/icon.icns",
    "background": null,
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ],
    "window": { "width": 540, "height": 400 }
  },
  "linux": {
    "target": [
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icons/icon.png",
    "category": "Office",
    "maintainer": "Zapeera Team <support@zapeera.com>"
  },
  "deb": {
    "priority": "optional",
    "depends": [],
    "maintainer": "Zapeera Team <support@zapeera.com>"
  },
  "extraMetadata": {
    "main": "electron/main.js"
  }
}
