# Desktop (Electron) build configuration — loaded by `vite build --mode desktop`.
#
# The desktop renderer's cloud client (src/lib/config.ts) reads
# VITE_CLOUD_API_URL and has NO fallback in Electron: when it is empty,
# getCloudApi() throws "Cloud API URL not configured" and v1.0.1 shipped
# exactly that way (no .env.desktop existed and the release workflow set
# nothing), which left the app stuck on the "Authenticating..." screen.
# Keep this file committed and in sync with the release workflow env.
VITE_CLOUD_API_URL=https://api.zapeera.seikho.online/api
