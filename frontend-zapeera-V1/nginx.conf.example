# Nginx Configuration for Zapeera Frontend
# This ensures proper MIME types and SPA routing

server {
    listen 80;
    server_name your-domain.com;
    
    root /path/to/frontend-zapeera-V1/dist;
    index index.html;

    # CRITICAL: Set proper MIME types for JavaScript files
    # This ensures .js files are served as application/javascript, not text/html
    location ~* \.js$ {
        # CRITICAL: Set correct MIME type for JavaScript
        add_header Content-Type application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
        
        # CRITICAL: If file doesn't exist, return 404, NOT index.html
        # This prevents MIME type errors when server returns HTML for missing .js files
        try_files $uri =404;
    }

    # CRITICAL: Set proper MIME types for other assets
    location ~* \.(css|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # CRITICAL: Serve index.html for all routes (SPA routing)
    # BUT: Only for routes that don't match actual files
    location / {
        try_files $uri $uri/ /index.html;
        
        # CRITICAL: Ensure JavaScript files are NOT served as HTML
        # If a .js file doesn't exist, return 404, don't serve index.html
        if ($uri ~ \.js$) {
            return 404;
        }
    }

    # CRITICAL: Explicitly handle assets directory
    location /assets/ {
        add_header Content-Type application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}

